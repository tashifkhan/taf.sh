  "scenes": [
    {
      "type": "platformIntro",
      "dur": 8.0,
      "kicker": "Stats API",
      "title": "Your stats. <em>One API shape.</em>",
      "tagline": "Coding platforms and self-hosted Git. Consistent JSON. Shareable SVG cards."
    },
    {
      "type": "stats",
      "dur": 7.2,
      "kicker": "What you get",
      "title": "A handle in the path. JSON back.",
      "items": [
        {
          "text": "7 + 2",
          "label": "Seven public platform APIs. Forgejo and Gitea for self-hosted Git."
        },
        {
          "text": "GET",
          "label": "Public platform APIs need no key. Put the handle in the path."
        },
        {
          "text": "24h",
          "label": "The SVG card caches for a day. Fine in a README."
        }
      ],
      "links": [
        "github-stats.tashif.codes",
        "leetcode-stats.tashif.codes",
        "codeforces-stats.tashif.codes",
        "gfg-stats.tashif.codes",
        "codechef-stats.tashif.codes",
        "hackerrank-stats.tashif.codes",
        "tuf-stats.tashif.codes"
      ],
      "foot": ""
    },
    {
      "type": "arch",
      "dur": 8.4,
      "kicker": "How a call runs",
      "title": "The path names the section.",
      "cols": 7,
      "rows": 3,
      "nodes": [
        {
          "id": "in",
          "x": 0,
          "y": 1,
          "kind": "request",
          "label": "GET",
          "sub": "/{handle}/profile"
        },
        {
          "id": "api",
          "x": 3,
          "y": 1,
          "kind": "service",
          "label": "One host",
          "sub": "FastAPI, its platform",
          "hot": true
        },
        {
          "id": "up",
          "x": 6,
          "y": 0,
          "kind": "upstream",
          "label": "The platform",
          "sub": "public profile"
        },
        {
          "id": "out",
          "x": 6,
          "y": 2,
          "kind": "response",
          "label": "Envelope",
          "sub": "status, platform, data"
        }
      ],
      "edges": [
        {
          "from": "in",
          "to": "api",
          "label": "handle"
        },
        {
          "from": "api",
          "to": "up"
        },
        {
          "from": "up",
          "to": "out",
          "label": "mapped"
        }
      ]
    },
    {
      "type": "chapter",
      "dur": 4.6,
      "n": 1,
      "still": "assets/stills/envelope.png",
      "path": "/",
      "title": "The same routes on every host.",
      "body": "Profile, stats, contests, rating, heatmap, badges. A missing value comes back null, not omitted.",
      "points": [
        "platform and username sit on every response",
        "Old paths stay, marked legacy",
        "OpenAPI and ReDoc ship with the service"
      ]
    },
    {
      "type": "demo",
      "n": 1,
      "path": "/",
      "caption": "The same five fields, on every response",
      "src": {
        "raw": "assets/footage/stats-api-data.webm",
        "a": 5.4,
        "b": 9.4,
        "speed": 1
      },
