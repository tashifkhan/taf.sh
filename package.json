{
  "name": "taf.sh",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.3.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "bun run seo:images && astro build && bun run seo:crawlers",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "bun run build && wrangler deploy",
    "cf:dev": "bun run build && wrangler dev",
    "seo:images": "bun scripts/generate-social-images.ts",
    "seo:crawlers": "bun scripts/generate-crawler-content.ts",
    "seo:check": "bun run build && bun scripts/check-seo.ts && bun scripts/check-crawlers.ts && bun test scripts/crawler-markdown.test.ts worker/index.test.ts",
    "seo:crawlers:live": "bun scripts/check-crawlers-live.ts",
    "seo:check:live": "bun scripts/check-social-live.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-narrow": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/overpass": "^5.3.0",
    "@fontsource/overpass-mono": "^5.3.0",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "parse5": "7.3.0",
    "sharp": "0.35.3",
    "turndown": "7.2.4",
    "wrangler": "^4.118.0"
  }
}
