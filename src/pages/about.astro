---
import Layout from "../layouts/Layout.astro";

const facts = [
	{ label: "Legal form", value: "Sole proprietorship" },
	{ label: "Founder", value: "Tashif" },
	{ label: "Based", value: "India · remote-first" },
	{ label: "Personal site", value: "tashif.codes", href: "https://tashif.codes" },
	{
		label: "GitHub",
		value: "github.com/tashifkhan",
		href: "https://github.com/tashifkhan",
	},
	{ label: "Email", value: "me@tashif.codes", href: "mailto:me@tashif.codes" },
];

const beliefs = [
	{
		title: "Ownership end to end",
		body: "The person who designs the schema also writes the CSS and answers the email. Nothing gets lost between roles.",
	},
	{
		title: "Products over promises",
		body: "TalentSync and CliniQ are running systems, not portfolio mockups. The consulting offer is the same engineering, pointed at your problem.",
	},
	{
		title: "Small on purpose",
		body: "Staying solo keeps the work honest: few clients, deep focus, and no incentive to sell hours for the sake of hours.",
	},
];
---

<Layout
	title="About"
	description="taf.sh is the independent software studio and sole proprietorship of Tashif — builder of TalentSync and CliniQ."
>
	<div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
		<header class="max-w-2xl">
			<p class="font-mono text-sm text-accent">[*]</p>
			<h1
				class="mt-2 text-4xl font-semibold tracking-tight text-foreground md:text-6xl"
			>
				One person. Whole stack.
			</h1>
			<p class="mt-5 text-lg leading-8 text-secondary">
				taf.sh is the independent software studio of Tashif — a sole
				proprietorship that designs, builds, and operates software products,
				and consults for teams that want the same end-to-end ownership.
			</p>
		</header>

		<div class="mt-16 grid gap-16 lg:grid-cols-[1.4fr_1fr]">
			<!-- Story -->
			<div class="space-y-10">
				<section class="reveal">
					<h2 class="text-2xl font-semibold tracking-tight text-foreground">
						The studio
					</h2>
					<p class="mt-4 leading-7 text-secondary">
						It started with a frustration: hiring is broken on both sides.
						Job seekers bounce off ATS black boxes while recruiters drown in
						resumes. That became
						<a
							href="/products/talentsync"
							class="text-foreground underline underline-offset-4 hover:text-accent"
							>TalentSync</a
						> — an AI platform serving both candidates and hiring teams.
					</p>
					<p class="mt-4 leading-7 text-secondary">
						The second product,
						<a
							href="/products/cliniq"
							class="text-foreground underline underline-offset-4 hover:text-accent"
							>CliniQ</a
						>, came from another observation: clinics lose hours to phone tag
						while every patient already lives on WhatsApp. So the practice
						moved to where the patients are.
					</p>
					<p class="mt-4 leading-7 text-secondary">
						Between products, the studio takes on a small number of
						consulting engagements — the same architecture, AI, and
						full-stack work, applied to other people's hard problems.
					</p>
				</section>

				<section class="reveal">
					<h2 class="text-2xl font-semibold tracking-tight text-foreground">
						How it works
					</h2>
					<ul class="mt-6 space-y-6">
						{
							beliefs.map((belief) => (
								<li class="flex gap-3">
									<span class="font-mono text-sm text-accent">[*]</span>
									<p class="text-sm leading-6 text-secondary">
										<strong class="font-semibold text-foreground">
											{belief.title}
										</strong>{" "}
										— {belief.body}
									</p>
								</li>
							))
						}
					</ul>
				</section>
			</div>

			<!-- Facts -->
			<aside>
				<h2 class="font-mono text-xs tracking-wider text-faint uppercase">
					Facts
				</h2>
				<dl
					class="mt-4 divide-y divide-border border-y border-border font-mono text-sm"
				>
					{
						facts.map((fact) => (
							<div class="grid grid-cols-[7rem_1fr] gap-4 py-3.5">
								<dt class="text-muted">{fact.label}</dt>
								<dd class="text-secondary">
									{fact.href ? (
										<a
											href={fact.href}
											{...(fact.href.startsWith("mailto:")
												? {}
												: { target: "_blank", rel: "noopener noreferrer" })}
											class="text-foreground underline underline-offset-4 hover:text-accent"
										>
											{fact.value}
											{!fact.href.startsWith("mailto:") && " ↗"}
										</a>
									) : (
										fact.value
									)}
								</dd>
							</div>
						))
					}
				</dl>

				<div class="mt-10 border border-border bg-surface p-5">
					<p class="font-mono text-xs text-muted">
						<span class="text-accent">$</span> ls ~/elsewhere
					</p>
					<ul class="mt-4 space-y-2.5 font-mono text-sm">
						<li>
							<a
								href="https://tashif.codes"
								target="_blank"
								rel="noopener noreferrer"
								class="text-secondary transition-colors hover:text-foreground"
							>
								→ tashif.codes — personal site &amp; dashboard ↗
							</a>
						</li>
						<li>
							<a
								href="https://github.com/tashifkhan"
								target="_blank"
								rel="noopener noreferrer"
								class="text-secondary transition-colors hover:text-foreground"
							>
								→ github.com/tashifkhan — open source ↗
							</a>
						</li>
						<li>
							<a
								href="https://talentsync.tashif.codes"
								target="_blank"
								rel="noopener noreferrer"
								class="text-secondary transition-colors hover:text-foreground"
							>
								→ talentsync.tashif.codes ↗
							</a>
						</li>
					</ul>
				</div>
			</aside>
		</div>
	</div>
</Layout>
