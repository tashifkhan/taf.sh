---
import StudioLayout from "../layouts/StudioLayout.astro";
import Header from "../components/studio/Header.astro";
import Hero from "../components/studio/Hero.astro";
import Services from "../components/studio/Services.astro";
import Manifesto from "../components/studio/Manifesto.astro";
import Band from "../components/studio/Band.astro";
import Process from "../components/studio/Process.astro";
import Work from "../components/studio/Work.astro";
import Notes from "../components/studio/Notes.astro";
import Contact from "../components/studio/Contact.astro";
import StudioFooter from "../components/studio/StudioFooter.astro";
import Cursor from "../components/studio/Cursor.astro";
import Reel from "../components/studio/Reel.astro";
---

<StudioLayout title="Independent software studio">
	<div id="top"></div>
	<Header />
	<!--
		When the work view opens, studio.ts clips this wrapper to the current
		viewport slice and shrinks it into a rounded card inside the left 42%
		column, then cross-fades it into the reel's dark summary panel.
	-->
	<div data-page data-page-content>
		<main>
			<Hero />
			<Services />
			<Manifesto />
			<Process />
			<Band words={["Products", "tools", "Apps", "APIs"]} direction={-1} />
			<Work />
			<Notes />
			<Contact />
		</main>
		<StudioFooter cta={false} />
	</div>
	<Reel />
	<Cursor />
</StudioLayout>

<script>
	import { boot } from "../scripts/studio";
	boot();
</script>
