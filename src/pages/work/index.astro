---
import Arrow from "../../components/Arrow.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import PageIntro from "../../components/studio/PageIntro.astro";
import AsciiArt from "../../components/AsciiArt.astro";
import PreviewCard from "../../components/studio/PreviewCard.astro";
import { reel } from "../../components/studio/data";
import { projectSlug } from "../../lib/seo";
import { wrap, kicker, h2, btn, btnGhost, btnArrow } from "../../components/studio/ui";
const groups = [
	{ id: "product", name: "Studio products" },
	{ id: "team", name: "Team work" },
	{ id: "shenanigan", name: "Apps and developer tools" },
];
---
<PageLayout title="Work">
	<PageIntro summary="Software I've built and operated, plus my founding engineering work at Systematic Reasoning. Read the case studies or open the projects themselves.">
		<Fragment slot="title">Projects you<br />can <em>open.</em></Fragment>
		<a href="/contact" class:list={[btn, btnGhost]}>Discuss a project <span class={btnArrow} aria-hidden="true"><Arrow /></span></a>
	</PageIntro>
	{groups.map(group => <section class:list={[wrap, "pb-16 sm:pb-24"]} aria-labelledby={`group-${group.id}`}>
		<p class={kicker}>{group.id === "team" ? "Built with the team" : "Built by Tashif Ahmad Khan"}</p>
		<h2 id={`group-${group.id}`} class={h2}>{group.name}</h2>
		<div class="mt-8 divide-y divide-border border-y border-border">
			{reel.filter(item => item.group === group.id).map(item => <article id={projectSlug(item.name)} data-preview={item.shots[0] ?? item.video?.poster} data-preview-name={item.name} data-preview-meta={`${item.sector} · ${item.year}`} class="group relative grid scroll-mt-28 gap-5 py-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
				<div><h3 class="font-display text-2xl font-medium tracking-tight transition-colors group-hover:text-accent"><a href={item.href} class="after:absolute after:inset-0">{item.name}</a></h3><p class="mt-2 font-mono text-xs text-muted">{item.sector} · {item.year}</p></div>
				<div>
					<p class="max-w-[60ch] leading-7 text-secondary">{item.line}</p>
					<p class="mt-3 text-sm text-muted">Built with {item.stack.join(", ")}.</p>
					<div class="relative z-1 mt-5 flex flex-wrap gap-x-6 gap-y-3 text-sm">
						<a href={item.href} class="text-accent underline underline-offset-4">{item.href.startsWith("/") ? `Read the ${item.name} case study` : item.href.includes("github.com") ? `${item.name} source code` : `Open ${item.name}`}</a>
						{item.live && item.live !== item.href && <a href={item.live} class="text-secondary underline underline-offset-4">Visit {new URL(item.live).hostname}</a>}
					</div>
				</div>
			</article>)}
		</div>
	</section>)}
	<section class:list={[wrap, "grid gap-8 border-t border-border py-16 sm:py-24 lg:grid-cols-2"]}>
		<div><p class={kicker}>The personal site</p><h2 class={h2}>More on <em>tashif.codes.</em></h2><AsciiArt piece="tashif-codes" t={12} max={12} class="mt-10" /></div>
		<div class="space-y-5 leading-7 text-secondary">
			<p><a href="https://tashif.codes" rel="me" class="text-accent underline underline-offset-4">tashif.codes</a> is my personal portfolio and project directory. taf.sh is my software studio. Both cover work I build and maintain.</p>
			<p>My <a href="https://tashif.codes/blog" class="text-accent underline underline-offset-4">engineering blog</a> covers implementation details and lessons from these projects. The <a href="/work/tashif-codes" class="text-accent underline underline-offset-4">tashif.codes case study</a> documents the site's Astro build, search results and public traffic analytics.</p>
		</div>
	</section>
	<PreviewCard />
</PageLayout>
