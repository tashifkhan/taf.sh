---
import PageLayout from "../../layouts/PageLayout.astro";
import PageIntro from "../../components/studio/PageIntro.astro";
import { wrap, btn, btnLg, btnAccent, btnArrow } from "../../components/studio/ui";
import data from "../../data/tamjeed-proposals.json";
import "../../styles/proposal-studio.css";

const title = "Interior proposals · Tamjeed Khan";
const description = "Compare Ugra Creation, High Creation and Homebell, normalized for 6 rooms across 2 flats.";
const excelHref = "/proposals/Tamjeed_Khan_Proposal_Comparison.xlsx";
const views = [
  ["dashboard", "Overview"], ["itemized", "Itemized BOQ"], ["rooms", "By room"],
  ["gaps", "Inclusions & gaps"], ["proposals", "Original quotes"],
];
---

<PageLayout title={title} description={description} footerCta={false}>
  <PageIntro label="Client tools / Interior comparison" summary="Three interior proposals for Mr. Tamjeed Khan. Compare their costs and scope on the same basis, with six rooms across two flats.">
    <Fragment slot="title">Three quotes.<br />A clearer <em>picture.</em></Fragment>
    <a href={excelHref} class:list={[btn, btnLg, btnAccent]} download>
      Download Excel <span class={btnArrow} aria-hidden="true">↓</span>
    </a>
  </PageIntro>

  <div class:list={[wrap, "prop"]} id="prop-app">
    <nav class="prop-nav" aria-label="Comparison views">
      {views.map(([id, label], i) => <button type="button" class:list={[i === 0 && "active"]} data-page={id} aria-pressed={i === 0} aria-controls={`page-${id}`}>{label}</button>)}
    </nav>

    <div class="prop-wrap">
      <section class="prop-page active" id="page-dashboard" aria-label="Overview">
        <div class="prop-intro">
          <div>
            <p class="prop-eyebrow">01 / Overview</p>
            <h2>Compare the whole scope.</h2>
          </div>
          <div>
            <p>Ugra's single-flat quote is doubled. High Creation and Homebell already cover multiple units. A dash means an item is absent from a proposal, never a zero cost.</p>
            <button type="button" class="prop-text-link" data-page="itemized">Explore the itemized comparison <span aria-hidden="true">↗</span></button>
          </div>
        </div>
        <div class="prop-flyers" id="kpi-cards"></div>

        <section class="prop-section" aria-labelledby="ranking-title">
          <div class="prop-section-heading"><h2 id="ranking-title">Normalized costs</h2><p>Itemized totals, lowest first</p></div>
          <div class="prop-panel" id="rank-bars"></div>
          <p class="prop-legend"><span>Ugra ×2 for two flats</span><span>High Creation and Homebell ×1</span></p>
        </section>

        <div class="prop-section prop-grid-2">
          <section aria-labelledby="packages-title">
            <h2 class="prop-section-title" id="packages-title">Package comparison</h2>
            <p class="prop-scroll-hint">Scroll the table to compare all vendors →</p>
            <div class="prop-table-wrap" id="package-table" tabindex="0" role="region" aria-label="Package comparison table"></div>
          </section>
          <section aria-labelledby="reading-title">
            <h2 class="prop-section-title" id="reading-title">Before you compare</h2>
            <div class="prop-dashed">
              <ul class="prop-list">
                <li>Original totals follow the figures printed in each PDF.</li>
                <li>Normalized totals use Ugra ×2, High Creation ×1 and Homebell ×1.</li>
                <li>Dashes mean absent, so allow extra budget for missing items.</li>
                <li>The spreadsheet includes rates, quantities and room subtotals.</li>
              </ul>
              <div class="prop-callout">All three exclude bathroom and kitchen tile material. Ugra and High Creation also exclude stone supply and most sanitary CP fittings.</div>
            </div>
          </section>
        </div>
      </section>

      <section class="prop-page" id="page-itemized" aria-label="Itemized BOQ">
        <header class="prop-mast"><p class="prop-eyebrow">02 / Itemized BOQ</p><h2>Every line, side by side.</h2><p class="prop-tagline">Filter by room or search the mapped items. Switch between original and normalized amounts.</p></header>
        <div class="prop-filters">
          <div class="mode-row" role="group" aria-label="Comparison amounts">
            <button type="button" class="prop-btn active" data-mode="normalized" aria-pressed="true">Normalized</button>
            <button type="button" class="prop-btn ghost" data-mode="original" aria-pressed="false">Original</button>
          </div>
          <label class="prop-filter-label">Room<select id="room-filter"></select></label>
          <label class="prop-filter-label">Search<input id="search" type="search" placeholder="Item, room or note" autocomplete="off" /></label>
        </div>
        <p class="prop-scroll-hint">Scroll the table to see all columns →</p>
        <div class="prop-table-wrap" id="itemized-table" tabindex="0" role="region" aria-label="Itemized comparison table"></div>
      </section>

      <section class="prop-page" id="page-rooms" aria-label="By room">
        <header class="prop-mast"><p class="prop-eyebrow">03 / By room</p><h2>See where the costs sit.</h2><p class="prop-tagline">Room and zone subtotals across all three proposals.</p></header>
        <p class="prop-scroll-hint">Scroll the table to compare all vendors →</p>
        <div class="prop-table-wrap" id="room-table" tabindex="0" role="region" aria-label="Room comparison table"></div>
        <div class="prop-section prop-grid-2">
          <div class="prop-dashed"><h3>Where the scope differs</h3><ul class="prop-list">
            <li>Ugra alone prices a dining set and chairs.</li><li>Homebell includes granite and a kitchen sink.</li><li>Ugra includes multiple beds. Homebell includes almost none.</li><li>High Creation has a broader toilet EPC scope.</li><li>High Creation and Ugra supply light fixtures.</li>
          </ul></div>
          <div class="prop-dashed"><h3>The six-room map</h3><ul class="prop-list">
            <li>Living, lounge and dining</li><li>Kitchen</li><li>Master, BR2, BR3 and parents or extra bedroom</li><li>Toilets, false ceiling, paint, electrical and civil work</li>
          </ul></div>
        </div>
      </section>

      <section class="prop-page" id="page-gaps" aria-label="Inclusions and gaps">
        <header class="prop-mast"><p class="prop-eyebrow">04 / Inclusions & gaps</p><h2>What the quote leaves out.</h2><p class="prop-tagline">Check fittings, tiles, stone, lights, GST and warranty before deciding.</p></header>
        <p class="prop-scroll-hint">Scroll the table to compare all vendors →</p>
        <div class="prop-table-wrap" id="inclusion-table" tabindex="0" role="region" aria-label="Inclusions and gaps table"></div>
        <section class="prop-section" aria-labelledby="scope-notes"><h2 class="prop-section-title" id="scope-notes">Scope notes</h2><ul class="prop-strips">
          <li><strong>Tile material</strong><span>All three exclude it.</span></li>
          <li><strong>Stone supply</strong><span>Homebell supplies Z black granite. Ugra and High Creation cover fixing only.</span></li>
          <li><strong>GST</strong><span>Ugra quotes exclusive of GST. High Creation says 18% is included.</span></li>
          <li><strong>Light fixtures</strong><span>Homebell focuses on provisions. Allow a separate fixture budget.</span></li>
          <li><strong>Beds and dining</strong><span>Ugra includes more standalone furniture. The others focus on modular work.</span></li>
        </ul></section>
        <div class="prop-section prop-grid-2">
          <div class="prop-dashed"><h3>Allow extra budget</h3><ul class="prop-list"><li>Bathroom and kitchen tile material</li><li>Sanitaryware and most CP fittings</li><li>Chimney, hob, RO and geyser</li><li>AC wiring and full MCB-DB</li><li>Site measurement variance of 5 to 10%</li></ul></div>
          <div class="prop-dashed"><h3>Vendor notes</h3><ul class="prop-list"><li>Ugra excludes GST. Doubling assumes an identical second flat.</li><li>High Creation has the highest PDF total. A washbasin costs extra with its vanity.</li><li>Homebell includes design and execution. Budget separately for lights and beds.</li></ul></div>
        </div>
      </section>

      <section class="prop-page" id="page-proposals" aria-label="Original quotes">
        <header class="prop-mast"><p class="prop-eyebrow">05 / Original quotes</p><h2>Back to the source.</h2><p class="prop-tagline">Vendor details, quoted scope and the assumptions behind this comparison.</p></header>
        <div class="prop-tabs" role="tablist" aria-label="Vendor quotes">
          {[["ugra", "Ugra"], ["hc", "High Creation"], ["homebell", "Homebell"]].map(([key, name], i) => <button type="button" class:list={[i === 0 && "active"]} id={`tab-${key}`} data-prop={key} role="tab" aria-controls={`proposal-${key}`} aria-selected={i === 0} tabindex={i === 0 ? 0 : -1}>{name}</button>)}
        </div>
        {[["ugra", true], ["hc", false], ["homebell", false]].map(([key, active]) => <div id={`proposal-${key}`} class:list={["prop-detail", active && "active"]} role="tabpanel" aria-labelledby={`tab-${key}`} tabindex="0"></div>)}
        <section class="prop-section" aria-labelledby="normalization-title">
          <h2 class="prop-section-title" id="normalization-title">Normalization rules</h2>
          <p class="prop-scroll-hint">Scroll the table to see the full scope →</p>
          <div class="prop-table-wrap" tabindex="0" role="region" aria-label="Normalization rules"><table><thead><tr><th>Vendor</th><th>Original scope</th><th>Factor</th><th>Comparison basis</th></tr></thead><tbody>
            <tr><td>Ugra Creation</td><td>One house BOQ, roughly four bedroom zones</td><td>×2</td><td>Maximum furniture for two flats and six rooms</td></tr>
            <tr><td>High Creation</td><td>Ground floor, first floor and site handling</td><td>×1</td><td>Already covers roughly six bedrooms</td></tr>
            <tr><td>Homebell</td><td>Flat 1 and Flat 2 BOQs</td><td>×1</td><td>Already covers two 3BHK flats</td></tr>
          </tbody></table></div>
        </section>
        <div class="prop-download"><div><p class="prop-eyebrow">Take the details with you</p><h2>The full comparison.</h2><p>Itemized amounts, room subtotals and inclusion gaps in one spreadsheet.</p></div><a class="prop-btn" href={excelHref} download>Download Excel <span aria-hidden="true">↓</span></a></div>
      </section>
    </div>
    <footer class="prop-footer"><p>Prepared for Mr. Tamjeed Khan · Rajouri Garden</p><p>6 rooms / 2 flats</p></footer>
  </div>
		<script is:inline define:vars={{ data, excelHref }}>
			window.PROPOSAL_DATA = data;
			window.EXCEL_HREF = excelHref;
		</script>
		<script>
			type ProposalData = typeof import("../../data/tamjeed-proposals.json");

			function inr(v: number | null | undefined): string {
				if (v === null || v === undefined) return "—";
				const n = Math.round(Number(v));
				const neg = n < 0;
				let s = String(Math.abs(n));
				let out: string;
				if (s.length <= 3) out = s;
				else {
					out = s.slice(-3);
					s = s.slice(0, -3);
					while (s.length > 2) {
						out = s.slice(-2) + "," + out;
						s = s.slice(0, -2);
					}
					if (s) out = s + "," + out;
				}
				return (neg ? "-₹" : "₹") + out;
			}

			function tagMaterial(v: unknown): string {
				if (v === true || v === "True" || v === "true")
					return '<span class="prop-tag yes">Material in</span>';
				if (v === false || v === "False" || v === "false")
					return '<span class="prop-tag no">Labour / excl.</span>';
				return '<span class="prop-tag partial">Partial</span>';
			}

			function cellAmt(v: number | null | undefined): string {
				if (v === null || v === undefined) return '<td class="miss">—</td>';
				return `<td class="num">${inr(v)}</td>`;
			}

			function inclusionTag(text: string): string {
				const t = (text || "").toUpperCase();
				if (t.startsWith("NO") || t.includes("EXCLUD"))
					return `<span class="prop-tag no">${text}</span>`;
				if (t.startsWith("YES")) return `<span class="prop-tag yes">${text}</span>`;
				return `<span class="prop-tag partial">${text}</span>`;
			}

			function showPage(id: string) {
				document.querySelectorAll(".prop-page").forEach((p) => p.classList.remove("active"));
				const page = document.getElementById("page-" + id);
				if (page) page.classList.add("active");
				document.querySelectorAll(".prop-nav [data-page]").forEach((b) => {
					b.classList.toggle("active", b.getAttribute("data-page") === id);
					b.setAttribute("aria-pressed", String(b.getAttribute("data-page") === id));
				});
				page?.querySelector<HTMLElement>("h2")?.focus({ preventScroll: true });
				document.getElementById("prop-app")?.scrollIntoView({ behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth", block: "start" });
			}

			function renderDashboard() {
				const d = window.PROPOSAL_DATA as ProposalData;
				const s = d.stats;
				const notes = ["richest furniture", "deepest EPC + lights", "granite + sink in"];

				const cards = [
					{
						status: "×2 NORM",
						name: "Ugra Creation",
						meta: `${d.vendors.ugra.quote}<br>${d.vendors.ugra.date}`,
						metric: s.ugra_norm,
						metricNote: "Normalized (×2 single quote)",
						rows: [
							["PDF total", inr(s.pdf_totals.ugra)],
							["Itemized original", inr(s.ugra_orig)],
							["GST", "Exclusive"],
						],
						note: notes[0],
					},
					{
						status: "2 FLOORS",
						name: "High Creation",
						meta: `${d.vendors.hc.quote}<br>${d.vendors.hc.date}`,
						metric: s.hc_norm,
						metricNote: "Already GF + Floor 1",
						rows: [
							["PDF grand", inr(s.pdf_totals.hc)],
							["Itemized map", inr(s.hc_orig)],
							["GST", "18% included"],
						],
						note: notes[1],
					},
					{
						status: "2 FLATS",
						name: "Homebell",
						meta: "Flat 1 + Flat 2 · 01-08-2026",
						metric: s.hb_norm,
						metricNote: "Normalized itemized total",
						rows: [
							["PDF combined", inr(s.pdf_totals.homebell)],
							["Itemized map", inr(s.hb_orig)],
							["Warranty", "10 years modular"],
						],
						note: notes[2],
					},
				];

				const kpi = document.getElementById("kpi-cards");
				if (kpi) {
					kpi.innerHTML = cards
						.map(
							(c) => `
            <article class="prop-flyer">
              <p class="prop-flyer-status">${c.status}</p>
              <h3>${c.name}</h3>
              <p class="meta">${c.meta}</p>
              <div class="metric">${inr(c.metric)}<small>${c.metricNote}</small></div>
              ${c.rows
								.map(
									([k, v]) =>
										`<div class="prop-kpi-row"><span>${k}</span><strong>${v}</strong></div>`,
								)
								.join("")}
              <p class="prop-flyer-note">${c.note}</p>
            </article>`,
						)
						.join("");
				}

				const ranks = [
					{ name: "Homebell (2 flats)", v: s.hb_norm, cls: "p3" },
					{ name: "High Creation", v: s.hc_norm, cls: "p2" },
					{ name: "Ugra (norm ×2)", v: s.ugra_norm, cls: "p1" },
				].sort((a, b) => a.v - b.v);
				const max = Math.max(...ranks.map((r) => r.v));
				const bars = document.getElementById("rank-bars");
				if (bars) {
					bars.innerHTML = ranks
						.map(
							(r, i) => `
            <div class="prop-bar-row">
              <div class="prop-bar-label" >${i + 1}. ${r.name}</div>
              <div class="prop-bar-track"><div class="prop-bar-seg ${r.cls}" style="width:${(r.v / max) * 100}%"></div></div>
              <div class="prop-bar-val">${inr(r.v)}</div>
            </div>`,
						)
						.join("");
				}

				const pkg = document.getElementById("package-table");
				if (pkg) {
					pkg.innerHTML = `
            <table>
              <thead><tr><th>Package</th><th class="num">Ugra Norm</th><th class="num">High Creation</th><th class="num">Homebell</th></tr></thead>
              <tbody>
                ${d.packages
									.map(
										(p) => `<tr>
                  <td>${p.name}</td>
                  ${cellAmt(p.ugra)}${cellAmt(p.hc)}${cellAmt(p.homebell)}
                </tr>`,
									)
									.join("")}
              </tbody>
            </table>`;
				}

				const room = document.getElementById("room-table");
				if (room) {
					room.innerHTML = `
            <table>
              <thead><tr>
                <th>Room / Zone</th>
                <th class="num">Ugra Original</th>
                <th class="num">Ugra ×2 Norm</th>
                <th class="num">High Creation</th>
                <th class="num">Homebell</th>
              </tr></thead>
              <tbody>
                ${d.room_stats
									.map(
										(r) => `<tr>
                  <td>${r.room}</td>
                  ${cellAmt(r.ugra)}${cellAmt(r.ugra_norm)}${cellAmt(r.hc)}${cellAmt(r.homebell)}
                </tr>`,
									)
									.join("")}
              </tbody>
            </table>`;
				}

				const incl = document.getElementById("inclusion-table");
				if (incl) {
					incl.innerHTML = `
            <table>
              <thead><tr><th>Aspect</th><th>Ugra</th><th>High Creation</th><th>Homebell</th></tr></thead>
              <tbody>
                ${d.inclusion
									.map(
										(row) => `<tr>
                  <td><strong>${row.aspect}</strong></td>
                  <td>${inclusionTag(row.ugra)}</td>
                  <td>${inclusionTag(row.hc)}</td>
                  <td>${inclusionTag(row.homebell)}</td>
                </tr>`,
									)
									.join("")}
              </tbody>
            </table>`;
				}
			}

			let itemMode = "normalized";

			function renderItemized(mode: string) {
				const d = window.PROPOSAL_DATA as ProposalData;
				const roomFilter = (document.getElementById("room-filter") as HTMLSelectElement)
					.value;
				const q = (
					(document.getElementById("search") as HTMLInputElement).value || ""
				).toLowerCase();
				const field = mode === "normalized" ? "norm" : "amt";

				let html = `<table><thead><tr>
          <th>Item</th><th>Category</th>
          <th class="num">Ugra</th><th class="num">High Creation</th><th class="num">Homebell</th>
          <th>Material</th><th>Notes / exclusions</th>
        </tr></thead><tbody>`;

				let current: string | null = null;
				const totals = { ugra: 0, hc: 0, homebell: 0 };
				const roomT = { ugra: 0, hc: 0, homebell: 0 };

				const items = d.items.filter((it) => {
					if (roomFilter !== "all" && it.room !== roomFilter) return false;
					if (q && !(it.item + it.notes + it.room).toLowerCase().includes(q))
						return false;
					return true;
				});

				function flushRoom() {
					if (!current) return;
					html += `<tr class="subtotal"><td colspan="2">Subtotal — ${current}</td>
            <td class="num">${inr(roomT.ugra || null)}</td>
            <td class="num">${inr(roomT.hc || null)}</td>
            <td class="num">${inr(roomT.homebell || null)}</td>
            <td colspan="2"></td></tr>`;
					roomT.ugra = roomT.hc = roomT.homebell = 0;
				}

				for (const it of items) {
					if (it.room !== current) {
						flushRoom();
						current = it.room;
						html += `<tr class="room-row"><td colspan="7">${it.room}</td></tr>`;
					}
					const u = field === "norm" ? it.ugra_norm : it.ugra_amt;
					const h = field === "norm" ? it.hc_norm : it.hc_amt;
					const b = field === "norm" ? it.homebell_norm : it.homebell_amt;
					if (u != null) {
						totals.ugra += u;
						roomT.ugra += u;
					}
					if (h != null) {
						totals.hc += h;
						roomT.hc += h;
					}
					if (b != null) {
						totals.homebell += b;
						roomT.homebell += b;
					}

					html += `<tr>
            <td><strong>${it.item}</strong><div style="color:var(--muted);font-size:.76rem;margin-top:3px">${it.notes}</div></td>
            <td><span class="prop-tag">${it.category}</span></td>
            ${u == null ? '<td class="miss">—</td>' : `<td class="num">${inr(u)}</td>`}
            ${h == null ? '<td class="miss">—</td>' : `<td class="num">${inr(h)}</td>`}
            ${b == null ? '<td class="miss">—</td>' : `<td class="num">${inr(b)}</td>`}
            <td>${tagMaterial(it.includes_material)}</td>
            <td style="color:var(--muted);font-size:.8rem">${it.client_scope_notes || "—"}</td>
          </tr>`;
				}
				flushRoom();
                if (!items.length) html += `<tr><td colspan="7">No items match these filters. Try another room or search.</td></tr>`;
				html += `<tr class="subtotal"><td colspan="2"><strong>Visible total</strong></td>
          <td class="num"><strong>${inr(totals.ugra)}</strong></td>
          <td class="num"><strong>${inr(totals.hc)}</strong></td>
          <td class="num"><strong>${inr(totals.homebell)}</strong></td>
          <td colspan="2"></td></tr></tbody></table>`;
				const el = document.getElementById("itemized-table");
				if (el) el.innerHTML = html;
			}

			function renderProposals() {
				const d = window.PROPOSAL_DATA as ProposalData;
				const s = d.stats;

				const blocks: Record<string, string> = {
					ugra: `
            <div class="prop-panel">
              <p class="prop-flyer-status">ORIGINAL PDF</p>
              <h3 class="prop-vendor-title" style="font-size:clamp(1.3rem,4vw,1.7rem);margin:.2rem 0 .5rem">Ugra Creation Interior Pvt Ltd</h3>
              <p class="meta" style="color:var(--muted);font-size:.88rem">Quote ${d.vendors.ugra.quote} · ${d.vendors.ugra.date}<br>
              ${d.vendors.ugra.address}<br>${d.vendors.ugra.contact}</p>
              <div class="prop-mini-metrics">
                <div class="prop-dashed"><div class="metric">${inr(s.pdf_totals.ugra)}<small>Original PDF total</small></div></div>
                <div class="prop-dashed"><div class="metric">${inr(s.ugra_norm)}<small>Normalized ×2</small></div></div>
              </div>
              <div class="prop-note-box">Scope: ${d.vendors.ugra.scope_note}</div>
              <div class="prop-grid-2" style="margin-top:1rem">
                <div class="prop-dashed"><h3>Strengths</h3>
                  <ul class="prop-list">
                    <li>Dining set, multi beds, dressing, shoe rack</li>
                    <li>Security doors ×3 + 7 door re-laminates</li>
                    <li>Gypsum FC + wiring + light fixtures</li>
                  </ul>
                </div>
                <div class="prop-dashed"><h3>Gaps</h3>
                  <ul class="prop-list">
                    <li>Stone & tiles material out</li>
                    <li>GST exclusive — add ~18% if applies</li>
                    <li>×2 assumes twin of quoted house</li>
                  </ul>
                </div>
              </div>
              <p class="prop-payment" style="margin-top:1rem">Payment: ${d.vendors.ugra.payment}</p>
            </div>`,
					hc: `
            <div class="prop-panel">
              <p class="prop-flyer-status">GF + F1</p>
              <h3 class="prop-vendor-title" style="font-size:clamp(1.3rem,4vw,1.7rem);margin:.2rem 0 .5rem">High Creation Interior Projects Pvt Ltd</h3>
              <p class="meta" style="color:var(--muted);font-size:.88rem">Quote ${d.vendors.hc.quote} · ${d.vendors.hc.date}<br>
              ${d.vendors.hc.address}<br>${d.vendors.hc.contact}</p>
              <div class="prop-mini-metrics three">
                <div class="prop-dashed"><div class="metric">${inr(s.hc_split.gf)}<small>Ground Floor</small></div></div>
                <div class="prop-dashed"><div class="metric">${inr(s.hc_split.f1)}<small>Floor 1</small></div></div>
                <div class="prop-dashed"><div class="metric">${inr(s.hc_split.grand)}<small>Grand (+ handling)</small></div></div>
              </div>
              <div class="prop-note-box">Scope: ${d.vendors.hc.scope_note}</div>
              <div class="prop-grid-2" style="margin-top:1rem">
                <div class="prop-dashed"><h3>Strengths</h3>
                  <ul class="prop-list">
                    <li>Already ~6 bedrooms — no doubling</li>
                    <li>Strong EPC + lights package</li>
                    <li>GST 18% included · 10yr modular</li>
                  </ul>
                </div>
                <div class="prop-dashed"><h3>Gaps</h3>
                  <ul class="prop-list">
                    <li>Stone & tiles material out</li>
                    <li>CP/sanitary material by client</li>
                    <li>Highest overall PDF cash</li>
                  </ul>
                </div>
              </div>
              <p class="prop-payment" style="margin-top:1rem">Payment: ${d.vendors.hc.payment}</p>
            </div>`,
					homebell: `
            <div class="prop-panel">
              <p class="prop-flyer-status">FLAT 1 + 2</p>
              <h3 class="prop-vendor-title" style="font-size:clamp(1.3rem,4vw,1.7rem);margin:.2rem 0 .5rem">Homebell Interiors Private Limited</h3>
              <p class="meta" style="color:var(--muted);font-size:.88rem">${d.vendors.homebell.quote}<br>
              ${d.vendors.homebell.address}<br>${d.vendors.homebell.contact}</p>
              <div class="prop-mini-metrics">
                <div class="prop-dashed"><div class="metric">${inr(s.homebell_split.flat1_net)}<small>Flat 1 after ~10%</small></div></div>
                <div class="prop-dashed"><div class="metric">${inr(s.homebell_split.flat2_net)}<small>Flat 2 after ~10%</small></div></div>
              </div>
              <div class="prop-note-box">Scope: ${d.vendors.homebell.scope_note}</div>
              <div class="prop-callout">Flat 2 PDF discount line had OCR noise; net assumes same 10% structure as Flat 1.</div>
              <div class="prop-grid-2" style="margin-top:1rem">
                <div class="prop-dashed"><h3>Strengths</h3>
                  <ul class="prop-list">
                    <li>Granite supply + sink/faucet + accessories</li>
                    <li>Two full 3BHK modular stacks</li>
                    <li>Design + execution fees + 10yr warranty</li>
                  </ul>
                </div>
                <div class="prop-dashed"><h3>Gaps</h3>
                  <ul class="prop-list">
                    <li>Light fixtures largely not supplied</li>
                    <li>Beds almost absent · no dining set</li>
                    <li>Tiles still client · ±5–10% variance</li>
                  </ul>
                </div>
              </div>
              <p class="prop-payment" style="margin-top:1rem">Payment: ${d.vendors.homebell.payment}</p>
            </div>`,
				};

				for (const key of ["ugra", "hc", "homebell"]) {
					const el = document.getElementById("proposal-" + key);
					if (el) el.innerHTML = blocks[key];
				}
			}

			function showProposal(key: string) {
				document
					.querySelectorAll(".prop-detail")
					.forEach((el) => el.classList.remove("active"));
				document.querySelectorAll(".prop-tabs button").forEach((b) => {
					const selected = b.getAttribute("data-prop") === key;
					b.classList.toggle("active", selected);
					b.setAttribute("aria-selected", String(selected));
					b.setAttribute("tabindex", selected ? "0" : "-1");
				});
				document.getElementById("proposal-" + key)?.classList.add("active");
			}

			document.addEventListener("DOMContentLoaded", () => {
				const d = window.PROPOSAL_DATA as ProposalData;
				const sel = document.getElementById("room-filter") as HTMLSelectElement;
				sel.innerHTML =
					`<option value="all">All rooms</option>` +
					d.rooms.map((r) => `<option value="${r}">${r}</option>`).join("");

				renderDashboard();
				renderItemized("normalized");
				renderProposals();
				document.querySelectorAll(".prop-page h2").forEach((el) => el.setAttribute("tabindex", "-1"));

				document.querySelectorAll("[data-page]").forEach((el) => {
					el.addEventListener("click", () =>
						showPage(el.getAttribute("data-page") || "dashboard"),
					);
				});

				document.querySelectorAll("[data-mode]").forEach((btn) => {
					btn.addEventListener("click", () => {
						itemMode = btn.getAttribute("data-mode") || "normalized";
						document.querySelectorAll("[data-mode]").forEach((b) => {
							const on = b === btn;
							b.classList.toggle("active", on);
							b.classList.toggle("ghost", !on);
						b.setAttribute("aria-pressed", String(on));
						});
						renderItemized(itemMode);
					});
				});

				document.querySelectorAll("[data-prop]").forEach((btn) => {
					btn.addEventListener("click", () =>
						showProposal(btn.getAttribute("data-prop") || "ugra"),
					);
				});

                document.querySelector(".prop-tabs")?.addEventListener("keydown", (event) => {
                    const e = event as KeyboardEvent;
                    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-prop]"));
                    const index = tabs.indexOf(document.activeElement as HTMLButtonElement);
                    if (index < 0 || !["ArrowLeft", "ArrowRight", "Home", "End"].includes(e.key)) return;
                    e.preventDefault();
                    const next = e.key === "Home" ? 0 : e.key === "End" ? tabs.length - 1 : (index + (e.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
                    tabs[next].click();
                    tabs[next].focus();
                });

				sel.addEventListener("change", () => renderItemized(itemMode));
				document
					.getElementById("search")
					?.addEventListener("input", () => renderItemized(itemMode));
			});

			declare global {
				interface Window {
					PROPOSAL_DATA: ProposalData;
					EXCEL_HREF: string;
				}
			}
		</script>
</PageLayout>
