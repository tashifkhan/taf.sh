---
import Arrow from "../components/Arrow.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { wrap, kicker, h1, lede, card, btn, btnAccent, btnGhost, btnArrow } from "../components/studio/ui";

/* What `ls /` prints in the terminal card. Every entry is a real page. */
const routes = [
	{ href: "/", name: "index", note: "the studio" },
	{ href: "/work", name: "work/", note: "projects you can open" },
	{ href: "/services", name: "services", note: "what I build" },
	{ href: "/about", name: "about", note: "who runs taf.sh" },
	{ href: "/contact", name: "contact", note: "start a project" },
];
---
<PageLayout title="404: page not found" description="This page does not exist. Browse taf.sh projects or return to the software studio homepage." noindex footerCta={false}>
	<section class="relative overflow-hidden pb-[clamp(4rem,8vw,7rem)]">
		<!-- Same faint layout grid as the homepage hero. -->
		<div
			class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-border)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-border)_1px,transparent_1px)] bg-size-[72px_72px] opacity-45 [mask-image:radial-gradient(ellipse_80%_70%_at_50%_40%,black_35%,transparent_100%)]"
			aria-hidden="true"
		>
		</div>
		<svg width="1440" height="900" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" class="pointer-events-none absolute inset-0 size-full" aria-hidden="true">
			<circle class="nf-draw" cx="1060" cy="260" r="230" fill="none" stroke="var(--color-border-strong)" stroke-width="1" opacity="0.7" pathLength="1" />
			<circle cx="1060" cy="260" r="130" fill="none" stroke="var(--color-accent)" stroke-width="1" stroke-dasharray="3 6" opacity="0.45" />
			<line class="nf-draw" x1="0" y1="260" x2="1440" y2="260" stroke="var(--color-border)" stroke-width="1" pathLength="1" />
			<line class="nf-draw" x1="1060" y1="0" x2="1060" y2="900" stroke="var(--color-border)" stroke-width="1" pathLength="1" />
			<circle cx="1060" cy="260" r="3.5" fill="none" stroke="var(--color-accent)" stroke-width="1" opacity="0.8" />
		</svg>

		<div class="pointer-events-none absolute inset-x-0 top-0 hidden font-mono text-xs text-muted lg:block" aria-hidden="true">
			<span class="absolute top-0 right-(--gutter)">sheet 404 · rev none</span>
		</div>

		<div class:list={[wrap, "relative"]}>
			<p class={kicker}>404 · drawing missing</p>

			<!-- The numeral: a teal outline that fills from the bottom, like the hero headline. -->
			<div class="relative mt-10 w-fit font-display text-[clamp(7.5rem,27vw,21rem)] leading-[0.8] font-[650] tracking-[-0.06em] select-none" aria-hidden="true">
				<span class="block text-transparent [-webkit-text-stroke:1.25px_var(--color-accent)]">40<span>4</span></span>
				<span class="nf-fill absolute inset-0 block text-foreground">40<span class="text-accent">4</span></span>

				<!-- Dimension callout across the top, labelled with the address that missed. -->
				<span class="absolute inset-x-0 -top-6 h-px">
					<span class="nf-dim absolute inset-x-0 top-0 h-px bg-accent/75"></span>
					<span class="absolute -top-1.5 left-0 h-3 w-px bg-accent"></span>
					<span class="absolute -top-1.5 right-0 h-3 w-px bg-accent"></span>
					<span class="absolute -top-2 left-1/2 max-w-[80%] -translate-x-1/2 truncate bg-background px-2.5 font-mono text-[0.6875rem] leading-4 tracking-normal text-accent" data-path-dim>GET /404</span>
				</span>
			</div>

			<div class="mt-14 grid gap-12 lg:mt-20 lg:grid-cols-[1fr_1fr] lg:gap-20">
				<div>
					<h1 class:list={[h1, "max-w-[13ch]"]}>This page was never <em>drawn.</em></h1>
					<p class={lede}>
						Nothing lives at this address. The link may be old, or the URL may have a typo. Everything I've
						shipped is on the work page.
					</p>
					<div class="mt-8 flex flex-wrap gap-3">
						<a href="/" class:list={[btn, btnAccent]} data-magnetic>Back home <span class={btnArrow} aria-hidden="true"><Arrow /></span></a>
						<a href="/work" class:list={[btn, btnGhost]} data-magnetic>Browse projects <span class={btnArrow} aria-hidden="true"><Arrow /></span></a>
					</div>
				</div>

				<div class:list={[card, "self-start overflow-hidden font-mono text-[0.8125rem] leading-6"]}>
					<div class="flex items-center gap-2 border-b border-border px-5 py-3 text-xs text-muted">
						<span class="size-2.5 rounded-full bg-border-strong"></span>
						<span class="size-2.5 rounded-full bg-border-strong"></span>
						<span class="size-2.5 rounded-full bg-border-strong"></span>
						<span class="ml-2">~/taf.sh</span>
					</div>
					<div class="space-y-4 px-5 py-5 text-secondary">
						<div>
							<p class="truncate"><span class="text-accent">$</span> curl -sI <span data-path-url>https://taf.sh/404</span></p>
							<p class="text-foreground">HTTP/2 404</p>
							<p class="text-muted">x-robots-tag: noindex</p>
						</div>
						<div>
							<p><span class="text-accent">$</span> ls /</p>
							<ul>
								{routes.map(route => <li class="grid grid-cols-[7rem_1fr] gap-3">
									<a href={route.href} class="text-foreground underline decoration-border-strong underline-offset-4 transition-colors hover:text-accent hover:decoration-accent">{route.name}</a>
									<span class="truncate text-muted"># {route.note}</span>
								</li>)}
							</ul>
						</div>
						<p><span class="text-accent">$</span> <span class="inline-block h-[1.1em] w-[0.55em] translate-y-[0.2em] bg-accent motion-safe:animate-[nf-blink_1.1s_steps(1)_infinite]" aria-hidden="true"></span></p>
					</div>
				</div>
			</div>
		</div>
	</section>
</PageLayout>

<script>
	/* The page is static, so the missed address only exists in the browser. */
	const path = decodeURI(location.pathname);
	document.querySelector("[data-path-dim]")!.textContent = `GET ${path}`;
	document.querySelector("[data-path-url]")!.textContent = `${location.origin}${path}`;
</script>

<style>
	@keyframes nf-wipe {
		from { clip-path: inset(100% -0.2em -0.1em 0); }
		to { clip-path: inset(0 -0.2em -0.1em 0); }
	}
	@keyframes nf-stroke {
		from { stroke-dashoffset: 1; }
	}
	@keyframes nf-grow {
		from { scale: 0 1; }
	}
	@keyframes nf-blink {
		50% { opacity: 0; }
	}
	@media (prefers-reduced-motion: no-preference) {
		.nf-fill { animation: nf-wipe 1.4s var(--ease-expo) 0.35s both; }
		.nf-dim { animation: nf-grow 0.9s var(--ease-expo) 0.15s both; }
		.nf-draw { stroke-dasharray: 1; animation: nf-stroke 1.8s var(--ease-expo) both; }
	}
</style>
