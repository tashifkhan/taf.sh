---
import Layout from "../layouts/Layout.astro";

const channels = [
	{
		label: "Email",
		value: "me@tashif.codes",
		href: "mailto:me@tashif.codes",
		note: "Fastest. Replies within a day or two.",
	},
	{
		label: "GitHub",
		value: "github.com/tashifkhan",
		href: "https://github.com/tashifkhan",
		note: "Code, open source, and issue trackers.",
	},
	{
		label: "Personal site",
		value: "tashif.codes",
		href: "https://tashif.codes",
		note: "Resume, writing, and everything else.",
	},
];

const checklist = [
	"What you're building, in a sentence or two",
	"Where you're stuck — idea, prototype, or scaling",
	"Timeline and rough budget range",
	"Links to anything that already exists",
];
---

<Layout
	title="Contact"
	description="Get in touch with taf.sh — one inbox, one human, fast replies."
>
	<div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
		<header class="max-w-2xl">
			<p class="font-mono text-sm text-accent">[*]</p>
			<h1
				class="mt-2 text-4xl font-semibold tracking-tight text-foreground md:text-6xl"
			>
				Say hello.
			</h1>
			<p class="mt-5 text-lg leading-8 text-secondary">
				One inbox, one human. Whether it's a project, a question about the
				products, or just to talk shop.
			</p>
		</header>

		<div class="mt-16 grid gap-16 lg:grid-cols-[1.2fr_1fr]">
			<!-- Channels -->
			<section class="reveal">
				<div class="divide-y divide-border border-y border-border">
					{
						channels.map((channel) => (
							<a
								href={channel.href}
								{...(channel.href.startsWith("mailto:")
									? {}
									: { target: "_blank", rel: "noopener noreferrer" })}
								class="group grid gap-1 py-6 sm:grid-cols-[10rem_1fr] sm:gap-6"
							>
								<span class="font-mono text-sm text-muted">
									{channel.label}
								</span>
								<span>
									<span class="text-xl font-semibold text-foreground group-hover:underline group-hover:underline-offset-4">
										{channel.value}
										{!channel.href.startsWith("mailto:") && " ↗"}
									</span>
									<span class="mt-1 block text-sm text-secondary">
										{channel.note}
									</span>
								</span>
							</a>
						))
					}
				</div>

				<div class="mt-10">
					<a
						href="mailto:me@tashif.codes?subject=Project%20inquiry%20—%20taf.sh"
						class="inline-block bg-accent px-5 py-2.5 font-mono text-sm text-accent-contrast transition-opacity hover:opacity-85"
					>
						Start a project inquiry →
					</a>
				</div>
			</section>

			<!-- Checklist -->
			<aside>
				<div class="border border-border bg-surface">
					<div
						class="border-b border-border px-5 py-3 font-mono text-xs text-muted"
					>
						$ cat good-first-email.md
					</div>
					<div class="p-5">
						<p class="text-sm leading-6 text-secondary">
							For project inquiries, the most useful first email includes:
						</p>
						<ul class="mt-5 space-y-4">
							{
								checklist.map((item) => (
									<li class="flex gap-3">
										<span class="font-mono text-sm text-accent">[*]</span>
										<span class="text-sm leading-6 text-secondary">
											{item}
										</span>
									</li>
								))
							}
						</ul>
						<p class="mt-6 font-mono text-xs leading-5 text-muted">
							No decks required. Two honest paragraphs beat a polished
							pitch.
						</p>
					</div>
				</div>
			</aside>
		</div>
	</div>
</Layout>
