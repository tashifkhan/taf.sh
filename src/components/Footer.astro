---
import Logo from "./Logo.astro";

const columns = [
	{
		title: "Products",
		links: [
			{ href: "/products/talentsync", label: "TalentSync AI" },
			{ href: "/products/talentsync-hr", label: "TalentSync HR" },
			{ href: "/products/rah-clinic", label: "rah.clinic" },
		],
	},
	{
		title: "Studio",
		links: [
			{ href: "/services", label: "Services" },
			{ href: "/about", label: "About" },
			{ href: "/contact", label: "Contact" },
		],
	},
	{
		title: "Elsewhere",
		links: [
			{
				href: "https://github.com/tashifkhan",
				label: "GitHub",
				external: true,
			},
			{ href: "https://tashif.codes", label: "tashif.codes", external: true },
			{ href: "https://tashif.codes/blog", label: "tashif.codes/blog", external: true },
			{ href: "mailto:me@taf.sh", label: "me@taf.sh" },
		],
	},
];
---

<footer class="border-t border-border">
	<div
		class="mx-auto grid max-w-6xl gap-12 px-6 py-16 md:grid-cols-[1.2fr_repeat(3,auto)]"
	>
		<div>
			<a href="/" class="inline-flex items-center gap-3">
				<Logo class="h-9 w-auto" />
				<span class="font-mono text-base text-foreground">taf.sh</span>
			</a>
			<p class="mt-4 max-w-xs text-sm leading-6 text-muted">
				An independent software studio. Products and consulting, built and run
				by one engineer.
			</p>
		</div>

		{
			columns.map((column) => (
				<div>
					<p class="font-mono text-xs text-faint">
						{column.title}
					</p>
					<ul class="mt-4 space-y-2.5 text-sm">
						{column.links.map((link) => (
							<li>
								<a
									href={link.href}
									{...(link.external
										? { target: "_blank", rel: "noopener noreferrer" }
										: {})}
									class="text-secondary transition-colors hover:text-foreground"
								>
									{link.label}
									{link.external && <span class="text-faint"> ↗</span>}
								</a>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>

	<div class="border-t border-border">
		<div
			class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-6 font-mono text-xs text-muted"
		>
			<p>©2026 taf.sh — a sole proprietorship</p>
			<div class="flex items-center gap-5">
				<a
					href="https://github.com/tashifkhan"
					target="_blank"
					rel="noopener noreferrer"
					class="transition-colors hover:text-foreground">GitHub ↗</a
				>
				<a
					href="https://tashif.codes"
					target="_blank"
					rel="noopener noreferrer"
					class="transition-colors hover:text-foreground">tashif.codes ↗</a
				>
			</div>
		</div>
	</div>
</footer>
