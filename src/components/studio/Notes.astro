---
import Arrow from "../Arrow.astro";
import { notes } from "./data";
import { wrap, section, head, headRow, kicker, h2, iconBtn, btn, btnGhost, btnArrow } from "./ui";
---

<!--
	No client quotes here on purpose. These are the studio's own positions, so
	nothing on the page claims words someone else didn't say.
-->
<section id="notes" class={section}>
	<div class={wrap}>
		<header class:list={[head, headRow]}>
			<div>
				<span class={kicker} data-scramble>04 / Notes</span>
				<h2 class={h2} data-split>How the studio <em>thinks.</em></h2>
			</div>
			<div class="flex items-center gap-4">
				<span class="font-mono text-xs text-muted tabular-nums">
					<b class="font-normal text-foreground" data-note-index>01</b> / {String(notes.length).padStart(2, "0")}
				</span>
				<div class="flex gap-2">
					<button type="button" class={iconBtn} data-note-prev aria-label="Previous note"><Arrow dir="left" /></button>
					<button type="button" class={iconBtn} data-note-next aria-label="Next note"><Arrow /></button>
				</div>
			</div>
		</header>

		<div class="group/notes">
			<div class="grid min-h-56 touch-pan-y" data-notes aria-roledescription="carousel" aria-live="polite">
				{
					notes.map((note, i) => (
						<article
							class="invisible grid translate-y-5 content-start gap-5 opacity-0 [grid-area:1/1] [transition:opacity_.6s,translate_.8s_var(--ease-expo),visibility_0s_.6s] aria-[hidden=false]:visible aria-[hidden=false]:translate-y-0 aria-[hidden=false]:opacity-100 aria-[hidden=false]:[transition:opacity_.6s_.15s,translate_.8s_var(--ease-expo)_.15s,visibility_0s]"
							data-note
							aria-roledescription="slide"
							aria-label={`${i + 1} of ${notes.length}`}
							aria-hidden={i === 0 ? "false" : "true"}
						>
							<p class="max-w-[22ch] font-display text-[clamp(1.6rem,3.4vw,2.6rem)] leading-[1.1] font-semibold tracking-[-0.03em] text-balance text-foreground">
								{note.title}
							</p>
							<p class="max-w-xl leading-7 text-secondary">{note.body}</p>
						</article>
					))
				}
			</div>
			<div class="mt-10 grid grid-flow-col gap-2" aria-hidden="true" data-note-bars>
				{
					notes.map(() => (
						<span class="h-0.5 overflow-hidden bg-border">
							<i class="block h-full origin-left scale-x-0 bg-accent in-[.done]:scale-x-100 in-[.run]:animate-note-run group-hover/notes:[animation-play-state:paused]" />
						</span>
					))
				}
			</div>

			<div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-border pt-6">
				<p class="text-sm text-secondary">
					Longer engineering writeups, post-mortems and architecture notes live on{" "}
					<a
						href="https://tashif.codes/blog"
						target="_blank"
						rel="noopener noreferrer"
						class="font-mono text-xs text-foreground underline decoration-border-strong underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
					>
						tashif.codes/blog <Arrow dir="up-right" />
					</a>
				</p>
				<a
					href="https://tashif.codes/blog"
					target="_blank"
					rel="noopener noreferrer"
					class:list={[btn, btnGhost]}
					data-magnetic
				>
					Visit tashif.codes/blog <span class={btnArrow} aria-hidden="true"><Arrow dir="up-right" /></span>
				</a>
			</div>
		</div>
	</div>
</section>
