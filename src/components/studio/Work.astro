---
import Arrow from "../Arrow.astro";
import Gallery from "./Gallery.astro";
import PreviewCard from "./PreviewCard.astro";
import { reel, products as productMeta } from "./data";
import { wrap, section, head, headRow, kicker, h2, lede, card, btn, btnGhost, btnArrow, chip, chipOn } from "./ui";

/*
 * Homepage work section:
 * 1. Featured team work and studio products get full-width galleries with
 *    their galleries, specs and case-study links (carrying the shared-element
 *    view-transition-name for the product page morph).
 * 2. The eight digital shenanigans sit below as a compact interactive index
 *    table (with cursor-following hover previews and one-click jump into the
 *    full split-screen reel), avoiding a second wall of galleries that repeats
 *    the slide-over work reel.
 */
const pad = (n: number) => String(n).padStart(2, "0");
const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const productId = (href: string) => (href.startsWith("/products/") ? href.slice("/products/".length) : null);

const featured = reel.filter((r) => r.group !== "shenanigan");
const shenanigans = reel.filter((r) => r.group === "shenanigan");
const metaById = Object.fromEntries(productMeta.map((p) => [p.id, p]));
---

<section id="work" class={section}>
	<div class={wrap}>
		<header class:list={[head, headRow]}>
			<div>
				<span class={kicker} data-scramble>03 / Work</span>
				<h2 class={h2} data-split>Things that <em>run.</em></h2>
			</div>
			<div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-6">
				<p class:list={[lede, "mt-0 max-w-sm text-[0.9375rem]"]}>
					Three studio products, team work at Systematic Reasoning, and the smaller tools built along the way.
				</p>
				<a href="/work" class="text-sm text-accent underline underline-offset-4">Browse all projects</a>
				<button type="button" class:list={[btn, btnGhost]} data-reel-open data-magnetic>
					Open full reel ({pad(reel.length)}) <span class={btnArrow} aria-hidden="true"><Arrow dir="up-right" /></span>
				</button>
			</div>
		</header>

		<ol class="divide-y divide-border border-t border-border">
			{
				featured.map((r, i) => {
					const pid = productId(r.href);
					const meta = pid ? metaById[pid] : undefined;
					return (
						<li
							id={`p-${slug(r.name)}`}
							class="grid scroll-mt-24 gap-8 py-12 sm:py-16 lg:grid-cols-[1.22fr_0.78fr] lg:items-center lg:gap-14"
							data-project
						>
							<div class:list={[i % 2 === 1 && "lg:order-2"]}>
								<Gallery name={r.name} shots={r.shots} video={r.video} live={r.live} />
							</div>

							<div class:list={[i % 2 === 1 && "lg:order-1"]}>
								<div class="flex flex-wrap items-center justify-between gap-3">
									<span class="font-mono text-xs text-accent">
										{pad(i + 1)} · {r.sector} · {r.year}
									</span>
									{r.metric && (
										<span class:list={[chip, meta?.status === "Live" && chipOn]}>
											{r.metric}
										</span>
									)}
								</div>

								<a
									href={r.href}
									class="mt-4 inline-block font-display text-[clamp(2rem,3.6vw,3rem)] leading-[1.02] font-semibold tracking-[-0.04em] text-foreground transition-colors hover:text-accent"
									style={pid ? `view-transition-name: product-${pid}; view-transition-class: product-title` : undefined}
								>
									{r.name}
								</a>

								<p class="mt-3 max-w-lg text-base leading-relaxed text-secondary">
									{r.line}
								</p>

								<dl class="mt-6 grid grid-cols-2 gap-4 border-y border-border py-4 font-mono text-xs">
									<div>
										<dt class="text-muted">Stack</dt>
										<dd class="mt-1 text-foreground">{r.stack.join(" · ")}</dd>
									</div>
									<div>
										<dt class="text-muted">{meta?.facts[0]?.[0] ?? "Stage"}</dt>
										<dd class="mt-1 text-foreground">{meta?.facts[0]?.[1] ?? r.metric ?? "Production"}</dd>
									</div>
								</dl>

								<div class="mt-6 flex flex-wrap items-center gap-5">
									<a href={r.href} class:list={[btn, btnGhost]}>
										Read case study <span class={btnArrow} aria-hidden="true"><Arrow /></span>
									</a>
									{r.live && (
										<a
											href={r.live}
											target="_blank"
											rel="noopener noreferrer"
											class="font-mono text-xs text-muted transition-colors hover:text-accent"
										>
											{r.live.replace(/^https?:\/\//, "")} <Arrow dir="up-right" />
										</a>
									)}
								</div>
							</div>
						</li>
					);
				})
			}
		</ol>

		<!-- Digital shenanigans: compact interactive index instead of a second wall of galleries. -->
		<div class="mt-6 border-t border-border pt-12 sm:pt-16">
			<div class="flex flex-wrap items-end justify-between gap-4">
				<div>
					<span class={kicker}>Archive · {pad(shenanigans.length)} builds</span>
					<h3 class="mt-2 font-display text-[clamp(1.65rem,3vw,2.35rem)] leading-tight font-semibold tracking-[-0.035em] text-foreground">
						Digital shenanigans<span class="text-accent">.</span>
					</h3>
				</div>
				<p class="max-w-md text-sm leading-relaxed text-secondary">
					Open-source agents, developer dashboards and campus tools built along the way.
					Click any row to inspect its screens in the reel.
				</p>
			</div>

			<ol class="mt-8 divide-y divide-border border-y border-border">
				{
					shenanigans.map((r, i) => (
						<li
							id={`p-${slug(r.name)}`}
							class="group relative scroll-mt-24 transition-colors hover:bg-surface/70"
							data-preview={r.shots[0] ?? r.video?.poster}
							data-preview-name={r.name}
							data-preview-meta={`${r.sector} · ${r.year}`}
						>
							<div class="grid items-baseline gap-x-6 gap-y-1.5 py-4 sm:grid-cols-[2.25rem_11rem_1fr_auto_auto] sm:py-4.5">
								<span class="font-mono text-xs text-muted transition-colors group-hover:text-accent">
									{pad(i + 1)}
								</span>

								<button
									type="button"
									class="w-fit text-left font-display text-lg font-semibold tracking-[-0.025em] text-foreground transition-colors group-hover:text-accent"
									data-reel-open
									data-reel-target={`r-${slug(r.name)}`}
								>
									{r.name}
								</button>

								<p class="text-sm text-secondary sm:truncate">{r.line}</p>

								<span class="font-mono text-xs text-muted max-md:hidden">
									{r.stack.join(" · ")}
									{r.metric ? <span class="text-accent"> · {r.metric}</span> : ""}
								</span>

								<div class="flex items-center gap-4 font-mono text-xs sm:justify-end">
									<button
										type="button"
										class="text-muted transition-colors hover:text-accent"
										data-reel-open
										data-reel-target={`r-${slug(r.name)}`}
									>
										screens <Arrow dir="up-right" />
									</button>
									<a
										href={r.live ?? r.href}
										target="_blank"
										rel="noopener noreferrer"
										class="text-foreground transition-colors hover:text-accent"
									>
										visit <Arrow dir="up-right" />
									</a>
								</div>
							</div>
						</li>
					))
				}
			</ol>
			<div class="mt-6 flex flex-wrap items-center justify-between gap-4">
				<p class="text-sm text-secondary">
					These eight are a sample. Visit{" "}
					<a
						href="https://tashif.codes"
						target="_blank"
						rel="noopener noreferrer"
						class="font-mono text-xs text-foreground underline decoration-border-strong underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
					>
						tashif.codes <Arrow dir="up-right" />
					</a>{" "}
					for all 51 shenanigans, and{" "}
					<a
						href="https://tashif.codes/blog"
						target="_blank"
						rel="noopener noreferrer"
						class="font-mono text-xs text-foreground underline decoration-border-strong underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
					>
						tashif.codes/blog <Arrow dir="up-right" />
					</a>{" "}
					for the engineering writeups.
				</p>
				<div class="flex flex-wrap gap-2.5">
					<a
						href="https://tashif.codes"
						target="_blank"
						rel="noopener noreferrer"
						class:list={[btn, btnGhost]}
						data-magnetic
					>
						View more shenanigans on tashif.codes <span class={btnArrow} aria-hidden="true"><Arrow dir="up-right" /></span>
					</a>
					<a
						href="https://tashif.codes/blog"
						target="_blank"
						rel="noopener noreferrer"
						class:list={[btn, btnGhost]}
						data-magnetic
					>
						Visit tashif.codes/blog <span class={btnArrow} aria-hidden="true"><Arrow dir="up-right" /></span>
					</a>
				</div>
			</div>
		</div>
	</div>

	<PreviewCard />
</section>
