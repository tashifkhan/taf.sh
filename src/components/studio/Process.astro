---
import { process, engagements } from "./data";
import { wrap, section, kicker } from "./ui";
import AsciiArt from "../AsciiArt.astro";

const outputs = [
	"A clear problem to solve",
	"Deliverables, timeline & price",
	"Your first preview URL",
	"An end-to-end user flow",
	"Tested & ready for production",
	"Code, infrastructure & docs",
];
---

<section id="process" class:list={[section, "scroll-mt-16 border-t border-border bg-surface"]} aria-labelledby="process-title">
	<div class={wrap}>
		<div class="grid items-start gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
			<header class="lg:sticky lg:top-28">
				<span class={kicker}>02 / Process</span>
				<h2 id="process-title" class="mt-6 max-w-[12ch] font-display text-[clamp(2.5rem,4.4vw,3.75rem)] leading-[1.04] font-[600] tracking-[-0.04em]">
					A build you<br /> can follow<span class="text-accent">.</span>
				</h2>
				<p class="mt-6 max-w-[32ch] text-base leading-7 text-secondary">
					A typical build takes five weeks. You get a preview in week two,
					then a new increment every week.
				</p>
				<p class="mt-7 max-w-[34ch] border-l border-accent pl-4 text-sm leading-6 text-muted">
					Your scope sets the timeline. We agree on it in writing before work starts.
				</p>
			</header>

			<ol class="border-t border-border">
				{
					process.map((p, i) => (
						<li class="grid grid-cols-[3.25rem_1fr] gap-x-4 border-b border-border py-6 sm:grid-cols-[4rem_1fr] sm:gap-x-6 sm:py-7">
							<div class="pt-0.5">
								<span class="block font-mono text-[0.6875rem] text-muted">Week</span>
								<span class:list={["mt-1 block font-mono text-[1.625rem] leading-none tracking-[-0.06em]", p.live ? "text-accent" : "text-muted"]}>
									{p.step}
								</span>
							</div>
							<div>
								<div class="flex flex-wrap items-center gap-3">
									<h3 class="font-display text-[1.375rem] leading-tight font-medium tracking-[-0.02em] text-foreground">{p.title}</h3>
									{p.live && <span class="inline-flex items-center gap-1.5 font-mono text-[0.625rem] text-accent"><span class="size-1 rounded-full bg-accent" aria-hidden="true"></span>Live</span>}
								</div>
								<p class="mt-2 max-w-[47ch] text-sm leading-6 text-secondary">{p.body}</p>
								<p class="mt-3 flex items-baseline gap-2 font-mono text-xs leading-5 text-muted">
									<span class="text-accent" aria-hidden="true">↳</span>
									<span>{outputs[i]}</span>
								</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>

		<figure class="mt-16 sm:mt-20">
			<AsciiArt piece="ci-pipeline" t={6} max={40} />
			<figcaption class="mt-4 font-mono text-xs text-muted"><span class="text-accent">Fig 2.</span> A pipeline run. Lint, tests and a build gate every deploy.</figcaption>
		</figure>

		<div class="mt-16 border-t border-border pt-7 sm:mt-20">
			<p class="font-mono text-xs text-muted">Ways to work together</p>
			<div class="mt-6 grid gap-7 md:grid-cols-3 md:gap-10">
				{
					engagements.map((e) => (
						<div>
							<h3 class="font-display text-lg font-medium tracking-[-0.02em] text-foreground">{e.title}</h3>
							<p class="mt-2 max-w-[35ch] text-sm leading-6 text-secondary">{e.body}</p>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>
