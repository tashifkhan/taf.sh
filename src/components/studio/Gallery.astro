---
import Arrow from "../Arrow.astro";
/*
 * A screenshot carousel: native horizontal scroll-snap (so touch swipes just
 * work), round arrow buttons, an `01 / 03` counter and an optional "live
 * site" badge. studio.ts wires the arrows and counter, and wipes the frame in
 * when it first scrolls into view.
 */
interface Props {
	name: string;
	shots: string[];
	/** A walkthrough video loaded on Play, then shown with the site's own controls. */
	video?: { src: string; poster: string; label?: string; phone?: { src: string; poster: string } };
	live?: string;
	class?: string;
	/** Load the first screen eagerly (above-the-fold use). */
	eager?: boolean;
}
const { name, shots, live, video, class: className, eager = false } = Astro.props;
const videos = video ? [
	{ src: video.src, poster: video.poster, label: video.label ?? (video.phone ? "Web walkthrough" : "Video"), width: 1280, height: 800 },
	...(video.phone ? [{ ...video.phone, label: "Phone walkthrough", width: 720, height: 1280 }] : []),
] : [];
const slides = videos.length + shots.length;
const pad = (n: number) => String(n).padStart(2, "0");
const control =
	"grid size-10 shrink-0 place-items-center rounded-lg transition-colors hover:bg-background focus-visible:outline-2 focus-visible:outline-accent";
const arrow =
	"absolute top-1/2 grid size-11 -translate-y-1/2 place-items-center rounded-full bg-white text-neutral-900 shadow-lg transition-[opacity,scale] hover:scale-105 disabled:pointer-events-none disabled:opacity-0 max-sm:size-9";
---

<div
	class:list={[
		"group/gal relative overflow-hidden rounded-2xl border border-border bg-surface shadow-[0_24px_60px_-30px_rgb(0_0_0/0.35)]",
		className,
	]}
	data-gallery
>
	<!--
		The wipe is on the track, not on the frame studio.ts observes: an
		IntersectionObserver applies the target's own clip-path, so a fully
		clipped frame would never count as visible.
	-->
	<div
		class="flex snap-x snap-mandatory overflow-x-auto overscroll-x-contain [scrollbar-width:none] in-[.js]:[clip-path:inset(100%_0_0_0)] in-[.in]:animate-clip-up in-[[data-reel]]:[clip-path:none]! in-[[data-reel]]:animate-none! motion-reduce:[clip-path:none]!"
		data-gallery-track
	>
		{
			videos.map((clip) => (
				<div class="relative aspect-16/10 w-full shrink-0 snap-start bg-black" data-video-player>
					<video
						data-video-src={clip.src}
						poster={clip.poster}
						playsinline
						preload="none"
						width={clip.width}
						height={clip.height}
						class="h-full w-full object-contain"
						aria-label={`${name} ${clip.label.toLowerCase()}`}
					/>
					<button
						type="button"
						class="group/play absolute inset-0 flex items-center justify-center focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-accent [&[hidden]]:hidden"
						aria-label={`Play ${name} ${clip.label.toLowerCase()}`}
						data-video-play
						hidden
					>
						<span class="flex items-center gap-3 rounded-full border border-white/25 bg-neutral-900/90 px-5 py-3 text-sm font-medium text-white shadow-lg backdrop-blur transition-colors group-hover/play:bg-accent group-hover/play:text-accent-contrast">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
							{clip.label === "Video" ? "Play video" : `Play ${clip.label.toLowerCase()}`}
						</span>
					</button>
					{/* The site's own controls. video.ts shows them once playback starts. */}
					<div
						class="absolute inset-x-3 bottom-3 flex touch-manipulation items-center gap-1 rounded-xl border border-border bg-surface px-1.5 py-1 text-foreground select-none [-webkit-tap-highlight-color:transparent] max-sm:gap-0 transition-opacity duration-200 in-data-[video-state=playing]:not-in-[[data-video-player]:hover]:not-in-[[data-video-player]:focus-within]:not-in-data-video-menu:opacity-0 [&[hidden]]:hidden"
						data-video-bar
						hidden
					>
						<button type="button" class={control} aria-label="Pause" data-video-toggle>
							<svg class="in-data-[video-state=playing]:hidden" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
							<svg class="not-in-data-[video-state=playing]:hidden" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" /></svg>
						</button>
						<span class="min-w-10 text-center font-mono text-xs text-secondary tabular-nums" data-video-time>0:00</span>
						<input type="range" min="0" max="1000" value="0" step="1" aria-label="Seek" class="h-10 min-w-0 flex-1 cursor-pointer accent-accent" data-video-seek />
						<span class="min-w-10 text-center font-mono text-xs text-secondary tabular-nums max-sm:hidden" data-video-duration>0:00</span>
						<div class="shrink-0 sm:relative">
							<button type="button" class:list={[control, "w-auto min-w-10 px-2 font-mono text-xs tabular-nums"]} aria-expanded="false" aria-label="Playback speed, 1x" data-video-speed-btn>1x</button>
							<div class="absolute right-0 bottom-[calc(100%+0.75rem)] grid w-60 gap-3 rounded-xl border border-border bg-surface p-4 text-sm max-sm:left-0 max-sm:w-auto max-sm:gap-2 max-sm:p-3 [&[hidden]]:hidden" data-video-speed-pop hidden>
								<label class="grid grid-cols-[1fr_auto] gap-x-4 gap-y-1 text-secondary">
									<span>Speed</span>
									<output class="font-mono text-foreground tabular-nums" data-video-speed-out>1x</output>
									<input type="range" min="0.25" max="3" step="0.25" value="1" class="col-span-2 h-8 w-full cursor-pointer accent-accent" data-video-speed-range />
								</label>
								<div class="grid grid-cols-5 gap-1">
									{[0.5, 1, 1.5, 2, 3].map((rate) => (
										<button type="button" class="h-8 rounded-lg border border-border font-mono text-xs tabular-nums transition-colors hover:bg-background data-on:border-foreground data-on:bg-foreground data-on:text-background" data-video-rate={rate}>{rate}x</button>
									))}
								</div>
							</div>
						</div>
						<button type="button" class={control} aria-label="Mute" data-video-mute>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M11 5 6 9H3v6h3l5 4z" fill="currentColor" />
								<path class="in-data-video-muted:hidden" d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13" />
								<path class="not-in-data-video-muted:hidden" d="m16 9 5 6M21 9l-5 6" />
							</svg>
						</button>
						<button type="button" class={control} aria-label="Picture in picture" data-video-pip>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h5" /><rect x="13" y="13" width="8" height="6" rx="1" fill="currentColor" /></svg>
						</button>
						<button type="button" class={control} aria-label="Full screen" data-video-full>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5" /></svg>
						</button>
					</div>
					<noscript>
						<a href={clip.src} class="absolute inset-0 flex items-center justify-center text-white">
							<span class="rounded-full bg-neutral-900/90 px-5 py-3 text-sm">Watch {name} demo</span>
						</a>
					</noscript>
				</div>
			))
		}
		{
			shots.map((src, k) => (
				<img
					src={src}
					alt={`${name}, screen ${k + 1} of ${shots.length}`}
					width="1200"
					height="750"
					loading={eager && k === 0 ? "eager" : "lazy"}
					decoding="async"
					class="aspect-16/10 w-full shrink-0 snap-start object-cover object-top"
				/>
			))
		}
	</div>

	{
		live && (
			<a
				href={live}
				target="_blank"
				rel="noopener noreferrer"
				class="absolute top-3 right-3 inline-flex h-8 items-center gap-2 rounded-full bg-neutral-900/85 px-3 ring-1 ring-white/25 text-xs leading-none font-medium text-white backdrop-blur transition-colors hover:bg-accent hover:text-accent-contrast"
			>
				<span class="size-1.5 rounded-full bg-accent" /> live site <Arrow dir="up-right" />
			</a>
		)
	}

	{
		slides > 1 && (
			<>
				<button type="button" class:list={[arrow, "left-3"]} aria-label={`Previous ${name} screen`} data-gallery-prev disabled>
					<Arrow dir="left" />
				</button>
				<button type="button" class:list={[arrow, "right-3"]} aria-label={`Next ${name} screen`} data-gallery-next>
					<Arrow />
				</button>
				<span class="absolute top-3 left-3 inline-flex h-8 items-center rounded-full bg-neutral-900/85 px-3 font-mono text-xs leading-none text-white ring-1 ring-white/15 tabular-nums backdrop-blur">
					<span data-gallery-index>01</span>&nbsp;/ {pad(slides)}
				</span>
			</>
		)
	}
</div>
