---
/*
 * Cursor-following project preview. Rows opt in with data-preview (image
 * URL), data-preview-name and data-preview-meta; workPreview() in studio.ts
 * moves the card to <body> and drives it. Hidden on touch and below lg.
 */
---

<div
	class="pointer-events-none fixed top-0 left-0 z-70 w-84 translate-x-(--px,-999px) translate-y-(--py,-999px) rotate-(--pr,0deg) scale-90 overflow-hidden rounded-2xl border border-border-strong bg-elevated opacity-0 shadow-[0_28px_70px_-20px_rgb(0_0_0/0.65)] transition-[opacity,scale] duration-350 ease-expo max-lg:hidden pointer-coarse:hidden [&.on]:scale-100 [&.on]:opacity-100"
	data-preview-card
	aria-hidden="true"
>
	<div class="flex items-center justify-between gap-3 border-b border-border px-3.5 py-2 font-mono text-[0.6875rem]">
		<span class="truncate font-medium text-foreground" data-preview-name-el></span>
		<span class="shrink-0 text-accent" data-preview-meta-el></span>
	</div>
	<img alt="" width="1200" height="750" class="aspect-16/10 w-full object-cover object-top" data-preview-img />
</div>
