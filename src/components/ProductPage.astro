---
import Layout from "../layouts/Layout.astro";
import CanvasEffect from "./canvas/CanvasEffect.astro";

interface Feature {
	title: string;
	body: string;
}

interface Spec {
	label: string;
	value: string;
	href?: string;
}

/**
 * Effect for the page body. Each product gets one that reads as its own
 * subject: dither for the document-decoding product, a coordinate grid for the
 * ranking one, a falling glyph stream for the messaging one.
 */
type BodyEffect = "retro-dither" | "grid" | "glyph-rain";

const BODY_OPTIONS: Record<BodyEffect, Record<string, number | string>> = {
	/*
	 * baseStrength stays at 0 so the page is only dithered under the cursor.
	 * Raising it would halftone every paragraph at rest and cost readability
	 * across a body this text-heavy.
	 */
	"retro-dither": {
		radius: 0.34,
		softness: 1,
		pixelSize: 2,
		levels: 4,
		strength: 0.55,
		baseStrength: 0,
		contrast: 0.5,
		colorize: 0,
		trail: 0.35,
		followSpeed: 3,
	},
	/*
	 * idleRipples stays at 0, so tiles are flat until the pointer moves over
	 * them. amplitude and liftHeight are well under the defaults because the
	 * tiles here carry running text rather than a poster.
	 */
	grid: {
		tileSize: 190,
		amplitude: 1.1,
		waveSpeed: 0.4,
		frequency: 9,
		waveWidth: 0.05,
		maxLift: 0.6,
		liftHeight: 26,
		tilt: 0.6,
		shading: 0.04,
		tintStrength: 0.12,
		idleRipples: 0,
	},
	/*
	 * dim is far below the 0.5 default: the glyph stream is an overlay and the
	 * text underneath has to stay the brightest thing on the page.
	 */
	"glyph-rain": {
		cell: 13,
		speed: 0.16,
		density: 0.07,
		trail: 0.6,
		glow: 1.2,
		layers: 2,
		dim: 0.12,
		light: 1.6,
		lightRadius: 260,
		relief: 0.03,
		stir: 0.5,
		settle: 0.92,
	},
};

interface Props {
	/** Slug shared with the index list — drives the shared-element morph. */
	id: string;
	name: string;
	tagline: string;
	description: string;
	status: string;
	url?: string;
	features: Feature[];
	specs: Spec[];
	next: { name: string; href: string };
	/** Ambient effect for the body sections below the header. */
	bodyEffect: BodyEffect;
}

const {
	id,
	name,
	tagline,
	description,
	status,
	url,
	features,
	specs,
	next,
	bodyEffect,
} = Astro.props;
---

<Layout title={name} description={tagline}>
	<article class="mx-auto max-w-6xl px-6 py-16 md:py-20">
		<a
			href="/#products"
			class="font-mono text-sm text-muted transition-colors hover:text-foreground"
		>
			← all products
		</a>

		<!-- Header -->
		<header class="mt-10">
			<div class="flex flex-wrap items-center gap-3 font-mono text-xs">
				<span class="text-accent">[*]</span>
				<span class="border border-border px-2 py-0.5 text-secondary"
					>{status}</span
				>
				{
					url && (
						<a
							href={`https://${url}`}
							target="_blank"
							rel="noopener noreferrer"
							class="text-muted transition-colors hover:text-foreground"
						>
							{url} ↗
						</a>
					)
				}
			</div>
			<h1
				class="mt-6 text-4xl font-semibold tracking-tight text-foreground md:text-6xl"
				style={`view-transition-name: product-${id}; view-transition-class: product-title`}
			>
				{name}
			</h1>
			<p class="mt-5 max-w-2xl text-lg leading-8 text-secondary">{tagline}</p>
			<p class="mt-4 max-w-2xl leading-7 text-secondary">{description}</p>

			{
				url && (
					<div class="mt-8 flex flex-wrap gap-4 font-mono text-sm">
						<a
							href={`https://${url}`}
							target="_blank"
							rel="noopener noreferrer"
							class="bg-accent px-5 py-2.5 text-accent-contrast transition-opacity hover:opacity-85"
						>
							Visit {name} ↗
						</a>
					</div>
				)
			}
		</header>

		<!--
			The wrapper starts below the header on purpose. The <h1> above carries
			view-transition-name, and moving it into a canvas would break the morph
			from the index list.
		-->
		<CanvasEffect effect={bodyEffect} options={BODY_OPTIONS[bodyEffect]}>
		<!-- Features -->
		<section class="reveal mt-20 border-t border-border pt-16">
			<h2 class="text-2xl font-semibold tracking-tight text-foreground">
				What it does
			</h2>
			<ul class="mt-10 grid gap-x-12 gap-y-10 md:grid-cols-2">
				{
					features.map((feature) => (
						<li>
							<p class="flex gap-3">
								<span class="font-mono text-sm text-accent">[*]</span>
								<strong class="font-semibold text-foreground">
									{feature.title}
								</strong>
							</p>
							<p class="mt-2 pl-8 text-sm leading-6 text-secondary">
								{feature.body}
							</p>
						</li>
					))
				}
			</ul>
		</section>

		<!-- Specs -->
		<section class="reveal mt-20 border-t border-border pt-16">
			<h2 class="text-2xl font-semibold tracking-tight text-foreground">
				Details
			</h2>
			<dl
				class="mt-8 max-w-3xl divide-y divide-border border-y border-border font-mono text-sm"
			>
				{
					specs.map((spec) => (
						<div class="grid gap-1 py-4 sm:grid-cols-[12rem_1fr] sm:gap-6">
							<dt class="text-muted">{spec.label}</dt>
							<dd class="text-secondary">
								{spec.href ? (
									<a
										href={spec.href}
										target="_blank"
										rel="noopener noreferrer"
										class="text-foreground underline underline-offset-4 hover:text-accent"
									>
										{spec.value} ↗
									</a>
								) : (
									spec.value
								)}
							</dd>
						</div>
					))
				}
			</dl>
		</section>

		<!-- Next product -->
		<footer class="mt-20 border-t border-border pt-10">
			<a href={next.href} class="group inline-flex items-baseline gap-4">
				<span class="font-mono text-sm text-muted">Next</span>
				<span
					class="text-2xl font-semibold text-foreground group-hover:underline group-hover:underline-offset-4"
				>
					{next.name}
				</span>
				<span
					class="font-mono text-sm text-muted transition-colors group-hover:text-accent"
					>→</span
				>
			</a>
		</footer>
		</CanvasEffect>
	</article>
</Layout>
