---
import Arrow from "./Arrow.astro";
import PageLayout from "../layouts/PageLayout.astro";
import Gallery from "./studio/Gallery.astro";
import CanvasEffect from "./canvas/CanvasEffect.astro";
import { reel } from "./studio/data";
import { wrap, kicker, h2, btn, btnLg, btnAccent, btnGhost, btnArrow, chip, chipOn, card } from "./studio/ui";

interface Feature {
	title: string;
	body: string;
}

interface Spec {
	label: string;
	value: string;
	href?: string;
}

/**
 * Effect for the page body. Each product gets one that reads as its own
 * subject: dither for the document-decoding product, a coordinate grid for the
 * ranking one, a falling glyph stream for the messaging one.
 */
type BodyEffect = "retro-dither" | "grid" | "glyph-rain";

const BODY_OPTIONS: Record<BodyEffect, Record<string, number | string>> = {
	/*
	 * baseStrength stays at 0 so the page is only dithered under the cursor.
	 * Raising it would halftone every paragraph at rest and cost readability
	 * across a body this text-heavy.
	 */
	"retro-dither": {
		radius: 0.34,
		softness: 1,
		pixelSize: 2,
		levels: 4,
		strength: 0.55,
		baseStrength: 0,
		contrast: 0.5,
		colorize: 0,
		trail: 0.35,
		followSpeed: 3,
	},
	/*
	 * idleRipples stays at 0, so tiles are flat until the pointer moves over
	 * them. amplitude and liftHeight are well under the defaults because the
	 * tiles here carry running text rather than a poster.
	 */
	grid: {
		tileSize: 190,
		amplitude: 1.1,
		waveSpeed: 0.4,
		frequency: 9,
		waveWidth: 0.05,
		maxLift: 0.6,
		liftHeight: 26,
		tilt: 0.6,
		shading: 0.04,
		tintStrength: 0.12,
		idleRipples: 0,
	},
	/*
	 * dim is far below the 0.5 default: the glyph stream is an overlay and the
	 * text underneath has to stay the brightest thing on the page.
	 */
	"glyph-rain": {
		cell: 13,
		speed: 0.16,
		density: 0.07,
		trail: 0.6,
		glow: 1.2,
		layers: 2,
		dim: 0.12,
		light: 1.6,
		lightRadius: 260,
		relief: 0.03,
		stir: 0.5,
		settle: 0.92,
	},
};

interface Props {
	/** Slug shared with the index list — drives the shared-element morph. */
	id: string;
	name: string;
	tagline: string;
	description: string;
	status: string;
	url?: string;
	features: Feature[];
	specs: Spec[];
	next: { name: string; href: string };
	/** Ambient effect for the body sections below the header. */
	bodyEffect: BodyEffect;
}

const {
	id,
	name,
	tagline,
	description,
	status,
	url,
	features,
	specs,
	next,
	bodyEffect,
} = Astro.props;

// Screens and tags come from the same entries as the homepage work view.
const entry = reel.find((r) => r.href === `/products/${id}`);
const nextEntry = reel.find((r) => r.href === next.href);
const live = url ? `https://${url}` : entry?.live;
const pad = (n: number) => String(n).padStart(2, "0");
// Every product links back to the engineer's own site.
const details: Spec[] = [...specs, { label: "Engineer", value: "Tashif / tashif.codes", href: "https://tashif.codes" }];
---

<PageLayout title={name} description={tagline}>
		<article>
			<header class:list={[wrap, "grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end"]}>
				<div>
					<div class="flex flex-wrap items-center gap-3">
						<span class:list={[chip, status === "Live" && chipOn]}>{status}</span>
						{entry && <span class={kicker}>{entry.sector} · {entry.year}</span>}
					</div>
					<h1
						class="mt-5 font-display text-[clamp(2.5rem,6vw,5rem)] leading-[0.98] font-[650] tracking-[-0.045em] text-foreground"
						style={`view-transition-name: product-${id}; view-transition-class: product-title`}
					>
						{name}
					</h1>
					<p class="mt-5 max-w-2xl text-lg leading-8 text-secondary sm:text-xl">{tagline}</p>
				</div>
				<div class="flex flex-wrap gap-3">
					{
						live && (
							<a href={live} target="_blank" rel="noopener noreferrer" class:list={[btn, btnLg, btnAccent]} data-magnetic>
								Visit {name} <span class={btnArrow} aria-hidden="true"><Arrow dir="up-right" /></span>
							</a>
						)
					}
					<a href="/contact" class:list={[btn, btnLg, btnGhost]} data-magnetic>
						Build one like it <span class={btnArrow} aria-hidden="true"><Arrow /></span>
					</a>
				</div>
			</header>

			{
				entry && (
					<div class:list={[wrap, "mt-12 sm:mt-16"]}>
						<Gallery name={name} shots={entry.shots} video={entry.video} live={live} eager />
					</div>
				)
			}

			<section class:list={[wrap, "mt-16 grid gap-10 sm:mt-24 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20"]}>
				<div>
					<span class={kicker}>Overview</span>
					<h2 class={h2}>
						Why it <em>exists.</em>
					</h2>
				</div>
				<div>
					<p class="text-lg leading-8 text-secondary">{description}</p>
					{
						entry && (
							<dl class="mt-8 grid grid-cols-2 gap-6 border-t border-border pt-6 sm:grid-cols-3">
								<div>
									<dt class="text-sm text-muted">Built with</dt>
									<dd class="mt-1 text-[0.9375rem] text-foreground">{entry.stack.join(", ")}</dd>
								</div>
								<div>
									<dt class="text-sm text-muted">Area</dt>
									<dd class="mt-1 text-[0.9375rem] text-foreground">{entry.tags.join(", ")}</dd>
								</div>
								{entry.metric && (
									<div>
										<dt class="text-sm text-muted">{entry.group === "team" ? "My role" : "Status"}</dt>
										<dd class="mt-1 text-[0.9375rem] text-accent">{entry.metric}</dd>
									</div>
								)}
							</dl>
						)
					}
				</div>
			</section>

			<!--
				The effect wrapper starts below the header on purpose. The <h1>
				carries view-transition-name, and moving it into a canvas would
				break the morph from the homepage list.
			-->
			<CanvasEffect effect={bodyEffect} options={BODY_OPTIONS[bodyEffect]}>
				<section class:list={[wrap, "mt-20 sm:mt-28"]} aria-labelledby="product-features">
					<h2 id="product-features" class={kicker}>What it does</h2>
					<ul class:list={["mt-6 grid gap-px overflow-hidden rounded-lg border border-border bg-border md:grid-cols-2", features.length % 3 === 0 && "xl:grid-cols-3"]}>
						{
							features.map((feature, i) => (
								<li class="bg-surface p-6 sm:p-7 lg:p-8">
									<div class="flex items-center gap-3" aria-hidden="true">
										<span class="font-mono text-xs text-accent">{pad(i + 1)} /</span>
										<span class="h-px w-6 bg-border-strong" />
									</div>
									<h3 class="mt-5 font-display text-[1.375rem] leading-[1.12] font-medium tracking-[-0.025em] text-foreground">{feature.title}</h3>
									<p class="mt-3 max-w-[52ch] text-[0.9375rem] leading-7 text-secondary">{feature.body}</p>
								</li>
							))
						}
					</ul>
				</section>

				<section class:list={[wrap, "mt-20 sm:mt-28"]}>
					<span class={kicker}>Details</span>
					<!-- A spec sheet in the same tiled grid as the features, so a wide screen gets cells rather than one long ruled list. -->
					<dl class:list={["mt-6 grid gap-px overflow-hidden rounded-lg border border-border bg-border sm:grid-cols-2", details.length % 3 === 0 && "lg:grid-cols-3"]}>
						{
							details.map((spec) => (
								<div class:list={["flex flex-col gap-3 bg-surface p-6 sm:p-7", details.length % 3 !== 0 && "sm:last:odd:col-span-2"]}>
									<dt class="font-mono text-xs text-muted">{spec.label}</dt>
									<dd class="min-w-0 break-words font-display text-lg leading-snug font-medium tracking-[-0.015em] text-foreground">
										{spec.href ? (
											<a
												href={spec.href}
												{...(spec.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}
												class="underline decoration-border-strong underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
											>
												{spec.value}
												{spec.href.startsWith("http") && <> <Arrow dir="up-right" /></>}
											</a>
										) : (
											spec.value
										)}
									</dd>
								</div>
							))
						}
					</dl>
				</section>
			</CanvasEffect>

			<nav class:list={[wrap, "mt-20 mb-8 sm:mt-28"]} aria-label="Next product">
				<a
					href={next.href}
					class:list={[card, "group grid items-center gap-6 overflow-hidden p-3 transition-colors hover:border-border-strong sm:grid-cols-[1fr_auto] sm:p-4"]}
				>
					<div class="px-3 py-2 sm:px-4">
						<span class="font-mono text-xs text-muted">Next product</span>
						<p class="mt-2 font-display text-[clamp(1.75rem,4vw,3rem)] leading-none font-semibold tracking-[-0.04em] text-foreground transition-colors group-hover:text-accent">
							{next.name} <span class="inline-block transition-transform duration-500 ease-expo group-hover:translate-x-2"><Arrow /></span>
						</p>
						{nextEntry && <p class="mt-3 max-w-md text-[0.9375rem] text-secondary">{nextEntry.line}</p>}
					</div>
					{
						nextEntry && (
							<img
								src={nextEntry.shots[0]}
								alt=""
								width="1200"
								height="750"
								loading="lazy"
								class="aspect-16/10 w-full rounded-2xl border border-border object-cover object-top transition-transform duration-700 ease-expo group-hover:scale-[1.02] sm:w-80"
							/>
						)
					}
				</a>
			</nav>
		</article>
</PageLayout>
