---
/**
 * The settings dock, ported from tashif.codes: theme mode, style and colour
 * combo, haptics and reduced motion in one panel pinned to the bottom-left
 * corner. It folds
 * into a round button once the page scrolls, and steps aside while the page
 * is moving.
 *
 * Every choice is an attribute on <html> plus a localStorage key, restored
 * before first paint by ThemeScript.astro. This file only changes them.
 */
const modes = [
	{ id: "system", label: "System" },
	{ id: "light", label: "Light" },
	{ id: "dark", label: "Dark" },
] as const;

import { SKIN_STYLES } from "../lib/skins";

/*
 * The previews are the one place this file paints with literal colours: each
 * sample has to show a style that is not on, so it cannot read the live
 * tokens. They come from src/lib/skins.ts as custom properties.
 */
const INK = "#191713";
const sampleEdge = (edge: string) => (edge === "ink" ? `1.5px solid ${INK}` : edge === "hair" ? "1px solid rgb(0 0 0 / 0.14)" : "none");

const card = "rounded-2xl border border-border bg-background/60 p-2.5";
const cardLabel = "truncate font-mono text-[0.625rem] tracking-wide text-muted";
const focus = "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent";
const sw =
	"group/sw relative h-5 w-9 shrink-0 cursor-pointer rounded-full bg-border-strong transition-colors aria-checked:bg-accent aria-disabled:cursor-not-allowed aria-disabled:opacity-50";
const knob =
	"absolute top-0.5 left-0.5 size-4 rounded-full bg-elevated shadow-sm ring-1 ring-border-strong transition-[translate] duration-300 ease-expo group-aria-checked/sw:translate-x-4";
---

<div
	class="group/dock fixed bottom-4 left-4 z-70 grid items-end justify-items-start transition-[opacity,translate] duration-300 ease-expo print:hidden sm:bottom-6 sm:left-6 [view-transition-name:settings-dock] [&.is-away]:pointer-events-none [&.is-away]:translate-y-4 [&.is-away]:opacity-0 max-sm:[html:has([data-toast]:not([hidden]))_&]:pointer-events-none max-sm:[html:has([data-toast]:not([hidden]))_&]:opacity-0"
	data-settings-dock
>
	<div
		id="settings-panel"
		role="group"
		aria-label="Appearance and motion"
		class="[grid-area:1/1] w-[min(calc(100vw-2rem),22rem)] origin-bottom-left rounded-[1.75rem] border border-border-strong bg-elevated/85 p-2.5 shadow-[0_24px_70px_-24px_rgb(0_0_0/0.55)] backdrop-blur-xl transition-[opacity,scale,translate,display] transition-discrete duration-400 ease-expo starting:translate-y-3 starting:scale-90 starting:opacity-0 [&[hidden]]:translate-y-3 [&[hidden]]:scale-75 [&[hidden]]:opacity-0"
		data-dock-panel
		hidden
	>
		<div class="flex items-center justify-between pl-1.5">
			<span class="flex items-center gap-1.5 font-mono text-[0.625rem] tracking-wide text-muted">
				<svg class="size-3" width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path d="M12 3a9 9 0 0 0 0 18Z" fill="currentColor"></path>
					<path d="M12 3a9 9 0 0 1 0 18Z" fill="var(--color-accent)"></path>
					<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"></circle>
				</svg>
				Appearance
			</span>
			<button
				type="button"
				class:list={["grid size-9 cursor-pointer place-items-center rounded-full text-muted transition-colors hover:text-foreground", focus]}
				aria-label="Collapse appearance settings"
				title="Collapse"
				data-haptic="manual"
				data-dock-close
			>
				<svg class="size-3.5" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
					<path d="m4 6 4 4 4-4"></path>
				</svg>
			</button>
		</div>

		<div role="radiogroup" aria-label="Color theme" class="mt-1.5 grid grid-cols-3 gap-1 rounded-[1.25rem] bg-background/60 p-1">
			{
				modes.map((mode) => (
					<button
						type="button"
						role="radio"
						aria-checked="false"
						aria-label={`${mode.label} theme`}
						title={`${mode.label} theme`}
						data-haptic="manual"
						data-theme-set={mode.id}
						class:list={[
							"flex h-9 cursor-pointer items-center justify-center gap-1.5 rounded-2xl border border-transparent font-mono text-[0.6875rem] text-muted transition-[color,background-color,border-color,scale] hover:text-foreground active:scale-95 aria-checked:border-accent/40 aria-checked:bg-accent-soft aria-checked:text-accent",
							focus,
						]}
					>
						{mode.id === "system" && (
							<svg class="size-3.5" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
								<rect x="1.5" y="2.5" width="13" height="9" />
								<path d="M5.5 14h5M8 11.5V14" />
							</svg>
						)}
						{mode.id === "light" && (
							<svg class="size-3.5" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
								<circle cx="8" cy="8" r="3.1" />
								<path d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.1 3.1l1.1 1.1M11.8 11.8l1.1 1.1M12.9 3.1l-1.1 1.1M4.2 11.8l-1.1 1.1" />
							</svg>
						)}
						{mode.id === "dark" && (
							<svg class="size-3.5" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
								<path d="M13.4 9.6A5.8 5.8 0 0 1 6.4 2.6a5.8 5.8 0 1 0 7 7Z" />
							</svg>
						)}
						{mode.label}
					</button>
				))
			}
		</div>

		<div class="mt-2 rounded-[1.25rem] border border-border bg-background/60 p-2.5">
			<p id="dock-style-label" class={cardLabel}>Style</p>
			<div role="radiogroup" aria-labelledby="dock-style-label" class="mt-2 grid grid-cols-5 gap-1">
				{
					SKIN_STYLES.map((style) => (
						<button
							type="button"
							role="radio"
							aria-checked="false"
							title={style.name}
							data-haptic="manual"
							data-skin-set={style.id}
							style={`--paper:${style.colors[0].paper};--ink-accent:${style.colors[0].accent}`}
							class:list={[
								"group/style flex cursor-pointer flex-col items-stretch gap-1.5 rounded-xl p-1 text-center transition-colors hover:bg-foreground/5 aria-checked:bg-foreground/10",
								focus,
							]}
						>
							{/* A sample card in the style's own corners, edge and shadow. */}
							<span class="relative block h-10 overflow-hidden rounded-lg bg-(--paper) ring-1 ring-foreground/10" aria-hidden="true">
								<span
									class="absolute inset-x-1.5 top-2 -bottom-1.5 block bg-white/90 px-1.5 pt-1.5"
									style={`border-radius:${style.radius}px;border:${sampleEdge(style.edge)};box-shadow:${style.stamp ? `2px 2px 0 ${INK}` : "none"}`}
								>
									<span class="block h-1.5 w-6 bg-(--ink-accent)" style={`border-radius:${style.radius > 8 ? 999 : style.radius / 3}px`}></span>
									<span class="mt-1 block h-1 w-full rounded-full bg-black/15"></span>
								</span>
							</span>
							<span class="truncate font-mono text-[0.625rem] leading-none text-muted group-hover/style:text-foreground group-aria-checked/style:text-foreground">{style.name}</span>
						</button>
					))
				}
			</div>

			<div class="mt-3 flex items-baseline justify-between gap-3">
				<p id="dock-color-label" class={cardLabel}>Colour</p>
				<p class="truncate font-mono text-[0.625rem] text-foreground" data-color-name></p>
			</div>
			{
				SKIN_STYLES.map((style) => (
					<div
						role="radiogroup"
						aria-labelledby="dock-color-label"
						class="mt-2 flex flex-wrap items-center gap-2"
						data-color-group={style.id}
						hidden
					>
						{style.colors.map((color) => (
							<button
								type="button"
								role="radio"
								aria-checked="false"
								aria-label={color.name}
								title={color.name}
								data-haptic="manual"
								data-color-set={color.id}
								data-color-label={color.name}
								class:list={[
									"size-7 cursor-pointer rounded-full p-0.5 ring-offset-2 ring-offset-elevated transition-[scale] hover:scale-110 aria-checked:ring-2 aria-checked:ring-foreground/60",
									focus,
								]}
							>
								{/* Paper on one half, accent on the other: the combo at a glance. */}
								<span
									class="block size-full rounded-full ring-1 ring-black/15"
									style={`background:linear-gradient(135deg,${color.paper} 0 50%,${color.accent} 50% 100%)`}
								></span>
							</button>
						))}
					</div>
				))
			}
		</div>

		<div class="mt-2 grid grid-cols-2 gap-2">
			<div class={card}>
				<p class={cardLabel}>Haptics</p>
				<div class="mt-2 flex h-7 items-center justify-between gap-2">
					<svg class="size-3.5 shrink-0 text-muted" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
						<rect x="5" y="2" width="6" height="12" rx="1.2"></rect>
						<path d="M2.5 5.5v5M13.5 5.5v5"></path>
					</svg>
					<button
						type="button"
						role="switch"
						aria-checked="false"
						aria-label="Haptic feedback"
						title="Vibrate on taps, on phones that support it"
						data-haptic="manual"
						data-haptics-switch
						class:list={[sw, focus]}
					>
						<span class={knob}></span>
					</button>
				</div>
			</div>

			<div class={card}>
				<p class={cardLabel}>Reduce motion</p>
				<div class="mt-2 flex h-7 items-center justify-between gap-2">
					<svg class="size-3.5 shrink-0 text-muted" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
						<path d="M1.5 8h3l1.5-3 2 6 1.5-3h5"></path>
					</svg>
					<button
						type="button"
						role="switch"
						aria-checked="false"
						aria-label="Reduce motion"
						data-haptic="manual"
						data-motion-switch
						class:list={[sw, focus]}
					>
						<span class={knob}></span>
					</button>
				</div>
			</div>
		</div>
	</div>

	<button
		type="button"
		class:list={[
			"group/open [grid-area:1/1] grid size-13 cursor-pointer place-items-center rounded-full border border-border-strong bg-elevated/85 text-foreground shadow-xl backdrop-blur-xl transition-[opacity,scale,display,border-color] transition-discrete duration-400 ease-expo hover:border-accent starting:scale-50 starting:opacity-0 [&[hidden]]:scale-50 [&[hidden]]:opacity-0",
			focus,
		]}
		aria-label="Open appearance settings"
		aria-controls="settings-panel"
		aria-expanded="false"
		title="Appearance and motion"
		data-haptic="manual"
		data-dock-open
	>
		<svg class="size-6 transition-transform duration-500 ease-expo group-hover/open:rotate-180" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
			<path d="M12 3a9 9 0 0 0 0 18Z" fill="currentColor"></path>
			<path d="M12 3a9 9 0 0 1 0 18Z" fill="var(--color-accent)"></path>
			<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"></circle>
		</svg>
	</button>
</div>

<script>
	import { KEYS, motionReduced, setReduceMotion, systemReducesMotion } from "../scripts/prefs";
	import { hapticsEnabled, installHaptics, setHapticsEnabled, trigger } from "../scripts/haptics";

	import { SKIN_COLORS_KEY, SKIN_KEY, SKIN_STYLES, type SkinId } from "../lib/skins";

	type Mode = "system" | "light" | "dark";

	const root = document.documentElement;
	const dock = document.querySelector<HTMLElement>("[data-settings-dock]")!;
	const panel = dock.querySelector<HTMLElement>("[data-dock-panel]")!;
	const openBtn = dock.querySelector<HTMLButtonElement>("[data-dock-open]")!;
	const closeBtn = dock.querySelector<HTMLButtonElement>("[data-dock-close]")!;
	const hapticsSwitch = dock.querySelector<HTMLButtonElement>("[data-haptics-switch]")!;
	const motionSwitch = dock.querySelector<HTMLButtonElement>("[data-motion-switch]")!;
	const prefersLight = matchMedia("(prefers-color-scheme: light)");
	const systemMotion = matchMedia("(prefers-reduced-motion: reduce)");
	const supportsTypes = CSS.supports("selector(:active-view-transition-type(theme))");

	const storage = {
		get: (key: string) => {
			try {
				return localStorage.getItem(key);
			} catch {
				return null;
			}
		},
		set: (key: string, value: string | null) => {
			try {
				if (value === null) localStorage.removeItem(key);
				else localStorage.setItem(key, value);
			} catch {}
		},
	};

	const readMode = (): Mode => {
		const stored = storage.get(KEYS.theme);
		return stored === "light" || stored === "dark" ? stored : "system";
	};
	const readSkin = (): SkinId => (SKIN_STYLES.some((s) => s.id === root.dataset.skin) ? (root.dataset.skin as SkinId) : "studio");
	const styleOf = (id: SkinId) => SKIN_STYLES.find((s) => s.id === id)!;
	const readColors = (): Record<string, string> => {
		try {
			return JSON.parse(storage.get(SKIN_COLORS_KEY) || "{}");
		} catch {
			return {};
		}
	};
	/** The combo a style opens with: the visitor's last pick for it, or its first. */
	const colorFor = (id: SkinId) => {
		const saved = readColors()[id];
		const style = styleOf(id);
		return style.colors.some((c) => c.id === saved) ? saved : style.colors[0].id;
	};

	const sync = () => {
		const mode = readMode();
		const skin = readSkin();
		const color = colorFor(skin);
		dock.querySelectorAll<HTMLElement>("[data-theme-set]").forEach((b) => b.setAttribute("aria-checked", String(b.dataset.themeSet === mode)));

		// Each style tile previews the combo that style would open with.
		dock.querySelectorAll<HTMLElement>("[data-skin-set]").forEach((tile) => {
			const id = tile.dataset.skinSet as SkinId;
			tile.setAttribute("aria-checked", String(id === skin));
			const shown = styleOf(id).colors.find((c) => c.id === colorFor(id))!;
			tile.style.setProperty("--paper", shown.paper);
			tile.style.setProperty("--ink-accent", shown.accent);
		});
		dock.querySelectorAll<HTMLElement>("[data-color-group]").forEach((group) => {
			group.hidden = group.dataset.colorGroup !== skin;
			if (group.hidden) return;
			group.querySelectorAll<HTMLElement>("[data-color-set]").forEach((b) => {
				const on = b.dataset.colorSet === color;
				b.setAttribute("aria-checked", String(on));
				if (on) dock.querySelector("[data-color-name]")!.textContent = b.dataset.colorLabel ?? "";
			});
		});

		hapticsSwitch.setAttribute("aria-checked", String(hapticsEnabled()));

		const systemReduce = systemReducesMotion();
		motionSwitch.setAttribute("aria-checked", String(motionReduced()));
		motionSwitch.toggleAttribute("aria-disabled", systemReduce);
		motionSwitch.title = systemReduce ? "Reduced by your system setting" : "Turn off page animations";

		// The browser chrome follows the page colour, whichever style painted it.
		document.querySelector("meta[data-theme-color]")?.setAttribute("content", getComputedStyle(document.body).backgroundColor);
	};

	const applyMode = (mode: Mode) => {
		if (mode === "system") delete root.dataset.theme;
		else root.dataset.theme = mode;
		storage.set(KEYS.theme, mode === "system" ? null : mode);
		// ThemeScript pins `color-scheme` inline so an override is live before the
		// stylesheet loads. That inline value outranks global.css, so keep it in
		// step instead of leaving the previous mode behind.
		root.style.colorScheme = mode === "system" ? "" : mode;
		sync();
	};

	/** Puts a style and its combo on <html>. Defaults set no attribute. */
	const applySkin = (skin: SkinId, color = colorFor(skin)) => {
		if (skin === "studio") delete root.dataset.skin;
		else root.dataset.skin = skin;
		if (color === styleOf(skin).colors[0].id) delete root.dataset.color;
		else root.dataset.color = color;
		storage.set(SKIN_KEY, skin === "studio" ? null : skin);
		storage.set(SKIN_COLORS_KEY, JSON.stringify({ ...readColors(), [skin]: color }));
		sync();
	};

	/**
	 * Mode, style and colour swaps share the circular reveal in global.css: it grows
	 * from the pressed control out to the farthest corner. Browsers without
	 * transition types would reuse the navigation slide, which reads wrong for
	 * a palette change, so they repaint instantly instead.
	 */
	const reveal = (origin: HTMLElement, update: () => void) => {
		if (!document.startViewTransition || !supportsTypes || motionReduced() || root.hasAttribute("data-theme-switch")) return update();
		const box = origin.getBoundingClientRect();
		const x = box.left + box.width / 2;
		const y = box.top + box.height / 2;
		root.style.setProperty("--vt-x", `${x}px`);
		root.style.setProperty("--vt-y", `${y}px`);
		root.style.setProperty("--vt-r", `${Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y))}px`);
		root.dataset.themeSwitch = "";
		try {
			const transition = document.startViewTransition({ update, types: ["theme"] } as unknown as () => void);
			transition.finished.finally(() => delete root.dataset.themeSwitch);
		} catch {
			delete root.dataset.themeSwitch;
			update();
		}
	};

	/* ---- open / closed ---- */

	const scrollTop = () => scrollY || root.scrollTop || 0;
	let expanded = false;

	const setExpanded = (next: boolean, { focus = false } = {}) => {
		if (next === expanded) return;
		expanded = next;
		panel.hidden = !next;
		openBtn.hidden = next;
		openBtn.setAttribute("aria-expanded", String(next));
		if (focus) (next ? closeBtn : openBtn).focus();
		armIdle();
	};

	// Once the page is scrolled, an open panel folds itself after 5s unless
	// the pointer or focus is still on it.
	let idle = 0;
	const armIdle = () => {
		clearTimeout(idle);
		if (!expanded || scrollTop() < 96) return;
		idle = window.setTimeout(() => {
			if (dock.matches(":hover") || dock.contains(document.activeElement)) return armIdle();
			setExpanded(false);
		}, 5000);
	};

	// The dock steps aside while the page moves and comes back 220ms after it
	// stops, folded unless the page is back at the top.
	let settle = 0;
	const onScroll = () => {
		dock.classList.add("is-away");
		clearTimeout(settle);
		settle = window.setTimeout(() => {
			dock.classList.remove("is-away");
			if (scrollTop() >= 96) setExpanded(false);
		}, 220);
	};
	addEventListener("scroll", onScroll, { passive: true });

	document.addEventListener(
		"pointerdown",
		(event) => {
			if (expanded && event.target instanceof Element && !event.target.closest("[data-settings-dock]")) setExpanded(false);
		},
		true,
	);

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && expanded) setExpanded(false, { focus: dock.contains(document.activeElement) });
	});

	openBtn.addEventListener("click", () => {
		trigger("selection");
		setExpanded(true, { focus: true });
	});

	closeBtn.addEventListener("click", () => {
		trigger("selection");
		setExpanded(false, { focus: true });
	});

	/* ---- choices ---- */

	dock.querySelectorAll<HTMLButtonElement>("[data-theme-set]").forEach((button) => {
		button.addEventListener("click", () => {
			trigger("selection");
			const mode = button.dataset.themeSet as Mode;
			if (mode !== readMode()) reveal(button, () => applyMode(mode));
		});
	});

	dock.querySelectorAll<HTMLButtonElement>("[data-skin-set]").forEach((button) => {
		button.addEventListener("click", () => {
			trigger("selection");
			const skin = button.dataset.skinSet as SkinId;
			if (skin !== readSkin()) reveal(button, () => applySkin(skin));
		});
	});

	dock.querySelectorAll<HTMLButtonElement>("[data-color-set]").forEach((button) => {
		button.addEventListener("click", () => {
			trigger("selection");
			const color = button.dataset.colorSet!;
			const skin = readSkin();
			if (color !== colorFor(skin)) reveal(button, () => applySkin(skin, color));
		});
	});

	hapticsSwitch.addEventListener("click", () => {
		const next = !hapticsEnabled();
		setHapticsEnabled(next);
		if (next) trigger("selection");
		sync();
	});

	motionSwitch.addEventListener("click", () => {
		if (systemReducesMotion()) return;
		trigger("selection");
		setReduceMotion(!root.hasAttribute("data-reduce-motion"));
		sync();
	});

	prefersLight.addEventListener("change", sync);
	systemMotion.addEventListener("change", sync);
	addEventListener("storage", (event) => {
		if (event.key === KEYS.theme) applyMode(readMode());
		else if (event.key === SKIN_KEY || event.key === SKIN_COLORS_KEY) applySkin(SKIN_STYLES.some((st) => st.id === storage.get(SKIN_KEY)) ? (storage.get(SKIN_KEY) as SkinId) : "studio");
		else if (event.key === KEYS.reduceMotion) root.toggleAttribute("data-reduce-motion", event.newValue === "true");
		sync();
	});

	installHaptics();
	sync();
	// Open on arrival near the top of the page, except on phones, where the
	// panel would cover a third of the first screen.
	if (scrollTop() < 96 && matchMedia("(min-width: 640px)").matches) setExpanded(true);
</script>
