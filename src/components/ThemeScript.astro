---
/**
 * Everything here is inline and sits above the stylesheet links on purpose: it
 * is the only styling the browser has between first byte and `global.css`
 * landing. Without it the UA paints its own defaults for that window — white
 * canvas, blue/purple link colours — which reads as a flash of unstyled content
 * on every navigation.
 *
 * The hex values duplicate `--color-background` / `--color-foreground` from
 * `global.css`. They have to: a token defined in the stylesheet cannot colour
 * the page before the stylesheet exists. Keep the two in sync.
 *
 * The fallback only covers Studio. Another style sets `data-skin` here, before
 * paint, and its own background comes from the inlined stylesheet.
 */
import { SKIN_COLOR_IDS, SKIN_COLORS_KEY, SKIN_KEY } from "../lib/skins";
---

<!-- Canvas follows the OS before any CSS parses; the script below pins it when
     the visitor has chosen an override. -->
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#0e0d0d" data-theme-color />

<style is:inline>
	/* Unlayered, so it would outrank every style's layered background. */
	html:not([data-skin]) {
		background-color: light-dark(#f6f1e9, #0e0d0d);
		color: light-dark(#171615, #f2f1f0);
	}

	/* Keep the pre-stylesheet fallback below Tailwind's text and hover utilities. */
	@layer base {
		a {
			color: inherit;
		}
	}
</style>

<script is:inline define:vars={{ colorIds: SKIN_COLOR_IDS, skinKey: SKIN_KEY, colorsKey: SKIN_COLORS_KEY }}>
	(() => {
		const root = document.documentElement;
		let stored = null;
		try {
			stored = localStorage.getItem("taf-theme");
			// The dock's style and colour combo. global.css reads both, so they
			// have to be on <html> before the first paint too. Studio, and each
			// style's first combo, set no attribute.
			const skin = localStorage.getItem(skinKey);
			const colors = JSON.parse(localStorage.getItem(colorsKey) || "{}");
			// The old single accent picker stored orange; amber is the closest combo.
			if (localStorage.getItem("taf-accent") === "orange") {
				colors.studio ??= "amber";
				localStorage.setItem(colorsKey, JSON.stringify(colors));
				localStorage.removeItem("taf-accent");
			}
			const style = skin && colorIds[skin] ? skin : "studio";
			if (style !== "studio") root.dataset.skin = style;
			if (colorIds[style].includes(colors[style])) root.dataset.color = colors[style];
			if (localStorage.getItem("taf-reduce-motion") === "true") root.setAttribute("data-reduce-motion", "");
		} catch {}
		const override = stored === "light" || stored === "dark";
		if (override) {
			root.dataset.theme = stored;
			// `data-theme` is only wired up in global.css, so set the used value
			// directly too — otherwise an override flashes the system palette
			// until the stylesheet arrives.
			root.style.colorScheme = stored;
		}
		const resolved = override
			? stored
			: matchMedia("(prefers-color-scheme: light)").matches
				? "light"
				: "dark";
		document
			.querySelector("meta[data-theme-color]")
			?.setAttribute("content", resolved === "light" ? "#f6f1e9" : "#0e0d0d");
	})();
</script>
