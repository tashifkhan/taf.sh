---
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";

const pathname = Astro.url.pathname;

const links = [
	{ href: "/#products", label: "Products", match: "/products" },
	{ href: "/services", label: "Services" },
	{ href: "/about", label: "About" },
	{ href: "https://github.com/tashifkhan", label: "GitHub", external: true },
];

const isActive = (link: (typeof links)[number]) =>
	link.match ? pathname.startsWith(link.match) : pathname === link.href;

const linkClass = (link: (typeof links)[number]) => [
	"transition-colors hover:text-foreground",
	{
		"text-foreground underline decoration-accent decoration-2 underline-offset-4":
			isActive(link),
	},
];
---

<header
	class="sticky top-0 z-50 border-b border-border bg-background/85 backdrop-blur-md"
	style="view-transition-name: site-nav"
>
	<nav
		class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-x-6 px-6"
	>
		<a
			href="/"
			class="flex shrink-0 items-center gap-3 font-mono text-sm tracking-tight text-foreground"
		>
			<Logo class="h-5 w-auto" />
			taf.sh
		</a>

		<!--
			The full bar only renders once there is room for it. Below `md` every
			item below moves into the disclosure panel instead of wrapping, which is
			what used to overflow the fixed `h-16` and clip the logo.
		-->
		<div
			class="hidden items-center gap-x-7 font-mono text-sm text-secondary md:flex"
		>
			{
				links.map((link) => (
					<a
						href={link.href}
						{...(link.external
							? { target: "_blank", rel: "noopener noreferrer" }
							: {})}
						class:list={linkClass(link)}
					>
						{link.label}
						{link.external && <span class="text-muted"> ↗</span>}
					</a>
				))
			}
			<ThemeToggle />

			<a
				href="/contact"
				class:list={[
					"border px-3 py-1.5 transition-colors",
					pathname === "/contact"
						? "border-accent text-accent"
						: "border-border-strong text-foreground hover:border-accent hover:text-accent",
				]}
			>
				Contact
			</a>
		</div>

		<!--
			`<details>` rather than a button: the open state, the toggle semantics and
			the keyboard behaviour all come from the UA, so the menu works before any
			script runs. The script at the bottom only closes it on same-page anchors.
		-->
		<details class="site-menu md:hidden">
			<summary
				class="flex h-9 w-9 cursor-pointer items-center justify-center border border-border-strong font-mono text-sm text-foreground transition-colors hover:border-accent hover:text-accent"
				aria-label="Menu"
			>
				<span class="site-menu-glyph-open">≡</span>
				<span class="site-menu-glyph-close">×</span>
			</summary>

			<div
				class="site-menu-panel border-b border-border bg-background/95 backdrop-blur-md"
			>
				<div class="mx-auto flex max-w-6xl flex-col px-6 pt-2 pb-5">
					{
						links.map((link) => (
							<a
								href={link.href}
								{...(link.external
									? { target: "_blank", rel: "noopener noreferrer" }
									: {})}
								class:list={[
									"border-b border-border py-3.5 font-mono text-sm text-secondary",
									...linkClass(link),
								]}
							>
								{link.label}
								{link.external && <span class="text-muted"> ↗</span>}
							</a>
						))
					}

					<div class="mt-5 flex items-center justify-between gap-4">
						<ThemeToggle />
						<a
							href="/contact"
							class:list={[
								"border px-4 py-2 font-mono text-sm transition-colors",
								pathname === "/contact"
									? "border-accent text-accent"
									: "border-border-strong text-foreground hover:border-accent hover:text-accent",
							]}
						>
							Contact
						</a>
					</div>
				</div>
			</div>
		</details>
	</nav>
</header>

<style>
	/*
	 * The default disclosure triangle is replaced by the glyph pair in the
	 * summary. Safari needs the vendor pseudo-element as well as `list-style`.
	 */
	.site-menu > summary {
		list-style: none;
	}

	.site-menu > summary::-webkit-details-marker {
		display: none;
	}

	.site-menu:not([open]) .site-menu-glyph-close,
	.site-menu[open] .site-menu-glyph-open {
		display: none;
	}

	/*
	 * The panel hangs off the bottom edge of the header rather than sitting in
	 * the nav flow, so opening the menu never changes the height of the sticky
	 * bar or pushes the page down.
	 */
	.site-menu-panel {
		position: absolute;
		top: 100%;
		right: 0;
		left: 0;
	}
</style>

<script>
	/*
	 * A cross-document navigation reloads the page and resets the disclosure on
	 * its own. Same-page anchors like `/#products` do not, so the panel would
	 * stay open over the section it just scrolled to.
	 */
	document.querySelectorAll<HTMLDetailsElement>(".site-menu").forEach((menu) => {
		menu.querySelectorAll("a").forEach((link) => {
			link.addEventListener("click", () => {
				menu.open = false;
			});
		});
	});
</script>
