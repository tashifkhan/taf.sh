---
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";

const pathname = Astro.url.pathname;

const links = [
	{ href: "/#products", label: "Products", match: "/products" },
	{ href: "/services", label: "Services" },
	{ href: "/about", label: "About" },
	{ href: "https://github.com/tashifkhan", label: "GitHub", external: true },
];

const isActive = (link: (typeof links)[number]) =>
	link.match ? pathname.startsWith(link.match) : pathname === link.href;
---

<header
	class="sticky top-0 z-50 border-b border-border bg-background/85 backdrop-blur-md"
>
	<nav
		class="mx-auto flex h-16 max-w-6xl flex-wrap items-center justify-between gap-x-6 px-6"
	>
		<a
			href="/"
			class="flex items-center gap-3 font-mono text-sm tracking-tight text-foreground"
		>
			<Logo class="h-5 w-auto" />
			taf.sh
		</a>

		<div
			class="flex flex-wrap items-center gap-x-5 gap-y-1 font-mono text-xs text-secondary sm:gap-x-7 sm:text-sm"
		>
			{
				links.map((link) => (
					<a
						href={link.href}
						{...(link.external
							? { target: "_blank", rel: "noopener noreferrer" }
							: {})}
						class:list={[
							"transition-colors hover:text-foreground",
							{
								"text-foreground underline decoration-accent decoration-2 underline-offset-4":
									isActive(link),
							},
						]}
					>
						{link.label}
						{link.external && <span class="text-muted"> ↗</span>}
					</a>
				))
			}
			<ThemeToggle />

			<a
				href="/contact"
				class:list={[
					"border px-3 py-1.5 transition-colors",
					pathname === "/contact"
						? "border-accent text-accent"
						: "border-border-strong text-foreground hover:border-accent hover:text-accent",
				]}
			>
				Contact
			</a>
		</div>
	</nav>
</header>
