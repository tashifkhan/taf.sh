---
/**
 * Ledger — bookkeeping book. Ruled lines, columns, quiet paper.
 * Professional restraint; no magazine drama.
 */
import { products, services, stats } from "./data";
---

<div class="vl">
	<header class="vl-head">
		<div>
			<p class="vl-book">Book of account · taf.sh</p>
			<p class="vl-year">Fiscal presentation 2026</p>
		</div>
		<nav>
			<a href="/services">Services</a>
			<a href="/about">About</a>
			<a href="/contact">Correspondence</a>
		</nav>
	</header>

	<section class="vl-title">
		<h1>Statement of the studio</h1>
		<p>
			taf.sh is an independent software practice. Assets include three product
			lines. Liabilities are finite attention. Owner-operator: Tashif.
		</p>
	</section>

	<section class="vl-sheet">
		<div class="vl-sheet-h">
			<span>Ref.</span>
			<span>Particulars</span>
			<span>Status</span>
			<span class="vl-right">Domain</span>
		</div>
		{
			products.map((p) => (
				<a href={p.href} class="vl-line">
					<span class="vl-ref">{p.index}</span>
					<span class="vl-part">
						<strong>{p.name}</strong>
						<em>{p.desc}</em>
					</span>
					<span class="vl-st">{p.status}</span>
					<span class="vl-right">{p.tag}</span>
				</a>
			))
		}
	</section>

	<section class="vl-totals">
		{
			stats.map((s) => (
				<div class="vl-total">
					<span class="vl-total-l">{s.label}</span>
					<span class="vl-total-v">{s.value}</span>
				</div>
			))
		}
	</section>

	<section class="vl-two">
		<div>
			<h2>Services rendered</h2>
			{
				services.map((s, i) => (
					<div class="vl-entry">
						<span class="vl-ref">S{i + 1}</span>
						<div>
							<strong>{s.title}</strong>
							<p>{s.body}</p>
						</div>
					</div>
				))
			}
		</div>
		<div class="vl-side">
			<h2>Balance</h2>
			<p>
				The practice remains small by design. New work is accepted when it does
				not compromise operation of existing products.
			</p>
			<p class="vl-sign">
				For enquiries:<br />
				<a href="/contact">Open correspondence</a><br />
				<a href="mailto:me@tashif.codes">me@tashif.codes</a>
			</p>
			<p class="vl-initials">— T.</p>
		</div>
	</section>

	<footer class="vl-foot">
		<span>Closed books remain available for inspection on request.</span>
		<span>© 2026 taf.sh</span>
	</footer>
</div>

<style>
	.vl {
		--paper: #f6f0e4;
		--rule: #c9bda8;
		--ink: #2a241c;
		--soft: #6b5f50;
		--red: #8b3a2a;
		background: var(--paper);
		color: var(--ink);
		font-family: "IBM Plex Sans", system-ui, sans-serif;
		min-height: 100vh;
		/* subtle ruled paper */
		background-image: repeating-linear-gradient(
			transparent,
			transparent 27px,
			rgba(201, 189, 168, 0.35) 27px,
			rgba(201, 189, 168, 0.35) 28px
		);
	}
	.vl a {
		color: var(--red);
	}
	.vl-head {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 1rem;
		padding: 1.5rem 1.5rem 1rem;
		max-width: 52rem;
		margin: 0 auto;
		border-bottom: 2px solid var(--ink);
		background: var(--paper);
	}
	.vl-book {
		margin: 0;
		font-family: "IBM Plex Mono", monospace;
		font-size: 0.75rem;
		letter-spacing: 0.04em;
	}
	.vl-year {
		margin: 0.2rem 0 0;
		font-size: 0.8rem;
		color: var(--soft);
	}
	.vl-head nav {
		display: flex;
		gap: 1.25rem;
		font-size: 0.8rem;
	}
	.vl-head nav a {
		color: var(--ink);
		text-decoration: none;
		border-bottom: 1px solid var(--rule);
	}
	.vl-head nav a:hover {
		border-color: var(--ink);
	}
	.vl-title {
		max-width: 52rem;
		margin: 0 auto;
		padding: 2.5rem 1.5rem 1.5rem;
		background: var(--paper);
	}
	.vl-title h1 {
		margin: 0;
		font-size: 1.75rem;
		font-weight: 600;
		letter-spacing: -0.02em;
	}
	.vl-title p {
		margin: 0.85rem 0 0;
		max-width: 36rem;
		font-size: 0.95rem;
		line-height: 1.65;
		color: var(--soft);
	}
	.vl-sheet {
		max-width: 52rem;
		margin: 0 auto;
		padding: 0 1.5rem 1rem;
		background: var(--paper);
	}
	.vl-sheet-h,
	.vl-line {
		display: grid;
		grid-template-columns: 2.5rem 1fr 6.5rem 5.5rem;
		gap: 0.75rem;
		align-items: baseline;
		padding: 0.65rem 0;
		border-bottom: 1px solid var(--rule);
	}
	.vl-sheet-h {
		font-family: "IBM Plex Mono", monospace;
		font-size: 0.65rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--soft);
		border-bottom-color: var(--ink);
	}
	.vl-line {
		text-decoration: none;
		color: inherit;
	}
	.vl-line:hover strong {
		color: var(--red);
	}
	.vl-ref {
		font-family: "IBM Plex Mono", monospace;
		font-size: 0.8rem;
		color: var(--soft);
	}
	.vl-part strong {
		display: block;
		font-size: 0.95rem;
		font-weight: 600;
	}
	.vl-part em {
		display: block;
		margin-top: 0.2rem;
		font-style: normal;
		font-size: 0.8rem;
		line-height: 1.45;
		color: var(--soft);
	}
	.vl-st {
		font-family: "IBM Plex Mono", monospace;
		font-size: 0.75rem;
	}
	.vl-right {
		text-align: right;
		font-size: 0.8rem;
		color: var(--soft);
	}
	.vl-totals {
		max-width: 52rem;
		margin: 0 auto;
		padding: 1.5rem;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		border-bottom: 2px solid var(--ink);
		background: var(--paper);
	}
	.vl-total {
		text-align: right;
	}
	.vl-total-l {
		display: block;
		font-size: 0.75rem;
		color: var(--soft);
	}
	.vl-total-v {
		display: block;
		margin-top: 0.25rem;
		font-family: "IBM Plex Mono", monospace;
		font-size: 1.75rem;
		font-weight: 500;
		letter-spacing: -0.02em;
	}
	.vl-two {
		max-width: 52rem;
		margin: 0 auto;
		padding: 2.5rem 1.5rem 3rem;
		display: grid;
		gap: 3rem;
		background: var(--paper);
	}
	@media (min-width: 800px) {
		.vl-two {
			grid-template-columns: 1.3fr 0.9fr;
		}
	}
	.vl-two h2 {
		margin: 0 0 1.25rem;
		font-size: 0.8rem;
		font-weight: 600;
		font-family: "IBM Plex Mono", monospace;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		border-bottom: 1px solid var(--ink);
		padding-bottom: 0.5rem;
	}
	.vl-entry {
		display: grid;
		grid-template-columns: 2rem 1fr;
		gap: 0.75rem;
		padding: 0.85rem 0;
		border-bottom: 1px solid var(--rule);
	}
	.vl-entry strong {
		display: block;
		font-size: 0.9rem;
	}
	.vl-entry p {
		margin: 0.25rem 0 0;
		font-size: 0.85rem;
		line-height: 1.5;
		color: var(--soft);
	}
	.vl-side p {
		margin: 0 0 1rem;
		font-size: 0.9rem;
		line-height: 1.65;
		color: var(--soft);
	}
	.vl-sign {
		margin-top: 2rem !important;
		font-size: 0.9rem !important;
		line-height: 1.7 !important;
		color: var(--ink) !important;
	}
	.vl-sign a {
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.vl-initials {
		margin-top: 2rem !important;
		font-family: "IBM Plex Mono", monospace;
		font-size: 1.1rem !important;
		color: var(--ink) !important;
	}
	.vl-foot {
		max-width: 52rem;
		margin: 0 auto;
		padding: 1.25rem 1.5rem 2rem;
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		font-family: "IBM Plex Mono", monospace;
		font-size: 0.65rem;
		color: var(--soft);
		border-top: 1px solid var(--rule);
		background: var(--paper);
	}
	@media (max-width: 700px) {
		.vl-sheet-h {
			display: none;
		}
		.vl-line {
			grid-template-columns: 2rem 1fr;
		}
		.vl-st,
		.vl-right {
			display: none;
		}
		.vl-totals {
			grid-template-columns: 1fr;
			text-align: left;
		}
		.vl-total {
			text-align: left;
			display: flex;
			justify-content: space-between;
			align-items: baseline;
			border-bottom: 1px solid var(--rule);
			padding-bottom: 0.5rem;
		}
		.vl-head nav {
			display: none;
		}
	}
</style>
