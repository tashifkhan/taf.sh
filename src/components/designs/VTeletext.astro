---
/**
 * Teletext — Ceefax page 100. Seven-colour palette on black, mosaic block
 * graphics, double-height headings, and a FASTEXT bar. Information as a
 * broadcast service: no scroll narrative, just pages.
 */
import "@fontsource/vt323/400.css";
import { products, services, process, stats, email } from "./data";

/** 8×5 mosaic of the pixel "T" mark, drawn in teletext block graphics. */
const mark = [
	"11111111",
	"11111111",
	"00011000",
	"00011000",
	"00022000",
];

const pages = [
	{ n: "101", label: "WHAT THE STUDIO IS", href: "#tt-101", c: "c-cyan" },
	{ n: "200", label: "PRODUCTS IN SERVICE", href: "#tt-200", c: "c-green" },
	{ n: "300", label: "SERVICES OFFERED", href: "#tt-300", c: "c-yellow" },
	{ n: "400", label: "HOW WORK PROCEEDS", href: "#tt-400", c: "c-magenta" },
	{ n: "500", label: "STUDIO IN NUMBERS", href: "#tt-500", c: "c-cyan" },
	{ n: "888", label: "CONTACT / SUBTITLES", href: "#tt-888", c: "c-white" },
];

const statusColour: Record<string, string> = {
	Live: "c-green",
	Beta: "c-yellow",
	"In development": "c-cyan",
};
---

<div class="vt">
	<div class="vt-screen">
		<div class="vt-page">
			<!-- STATUS ROW -->
			<div class="vt-status">
				<span class="c-white">P100</span>
				<span class="c-cyan">taf.sh</span>
				<span class="c-white">100</span>
				<span class="c-green">Sat 25 Jul</span>
				<span class="c-yellow" id="tt-clock">14:32/07</span>
			</div>

			<!-- MASTHEAD -->
			<div class="vt-masthead">
				<div class="vt-mosaic" aria-hidden="true">
					{
						mark.map((row) =>
							row.split("").map((cell) => (
								<span
									class:list={[
										"vt-px",
										cell === "1" ? "on-white" : cell === "2" ? "on-grey" : "",
									]}
								/>
							)),
						)
					}
				</div>
				<div class="vt-masthead-txt">
					<p class="vt-dbl c-yellow">taf.sh</p>
					<p class="vt-dbl-sub c-cyan">SOFTWARE STUDIO</p>
					<p class="c-white vt-tag">ONE OPERATOR &#183; THREE PRODUCTS</p>
				</div>
			</div>

			<div class="vt-sep" aria-hidden="true"></div>

			<!-- INDEX -->
			<nav class="vt-index" aria-label="Page index">
				<p class="vt-idx-head c-white">INDEX</p>
				{
					pages.map((p) => (
						<a class="vt-idx-row" href={p.href}>
							<span class="c-yellow vt-idx-n">{p.n}</span>
							<span class="vt-dots" aria-hidden="true" />
							<span class:list={["vt-idx-l", p.c]}>{p.label}</span>
						</a>
					))
				}
			</nav>

			<div class="vt-sep" aria-hidden="true"></div>

			<!-- 101 -->
			<section id="tt-101" class="vt-sec">
				<p class="vt-hd on-cyan">101 WHAT THE STUDIO IS</p>
				<p class="c-white vt-body">
					taf.sh is an independent software studio and
					<span class="c-cyan">sole proprietorship</span>. It designs, builds
					and operates its own products, and takes a small number of outside
					engagements each year.
				</p>
				<p class="c-white vt-body">
					There is no account team. The person who scopes the work is the person
					who writes it, deploys it and answers the pager at 3am.
				</p>
				<p class="c-green vt-body">
					&#9632; Weekly increments of running software.<br />
					&#9632; Written scope before any code.<br />
					&#9632; Full handover: code, infra, docs.
				</p>
			</section>

			<!-- 200 -->
			<section id="tt-200" class="vt-sec">
				<p class="vt-hd on-green">200 PRODUCTS IN SERVICE</p>
				{
					products.map((p, i) => (
						<a class="vt-prod" href={p.href}>
							<p class="vt-prod-top">
								<span class="c-yellow">{`2${i}${i}`}</span>
								<span class="c-white vt-prod-name">
									{p.name.toUpperCase()}
								</span>
								<span class:list={[statusColour[p.status] ?? "c-white"]}>
									{p.status.toUpperCase()}
								</span>
							</p>
							<p class="c-cyan vt-prod-desc">{p.desc}</p>
						</a>
					))
				}
				<p class="c-magenta vt-note">
					All three are operated by the studio itself. The stack sold is the
					stack run.
				</p>
			</section>

			<!-- 300 -->
			<section id="tt-300" class="vt-sec">
				<p class="vt-hd on-yellow">300 SERVICES OFFERED</p>
				<div class="vt-grid">
					{
						services.map((s, i) => (
							<div class="vt-cell">
								<p class="c-yellow vt-cell-n">{`3${i + 1}0`}</p>
								<p class="c-white vt-cell-t">{s.title.toUpperCase()}</p>
								<p class="c-cyan vt-cell-b">{s.body}</p>
							</div>
						))
					}
				</div>
			</section>

			<!-- 400 -->
			<section id="tt-400" class="vt-sec">
				<p class="vt-hd on-magenta">400 HOW WORK PROCEEDS</p>
				{
					process.map((p) => (
						<p class="vt-step">
							<span class="c-yellow">{`40${p.step}`}</span>
							<span class="c-white">{p.title.toUpperCase()}</span>
							<span class="c-cyan">{p.body}</span>
						</p>
					))
				}
			</section>

			<!-- 500 -->
			<section id="tt-500" class="vt-sec">
				<p class="vt-hd on-cyan">500 STUDIO IN NUMBERS</p>
				<div class="vt-stats">
					{
						stats.map((s) => (
							<div class="vt-stat">
								<p class="vt-big c-yellow">{s.value}</p>
								<p class="c-white vt-stat-l">{s.label.toUpperCase()}</p>
							</div>
						))
					}
				</div>
			</section>

			<!-- 888 -->
			<section id="tt-888" class="vt-sec">
				<p class="vt-hd on-white">888 CONTACT</p>
				<p class="c-white vt-body">
					Mail <a class="c-cyan" href={`mailto:${email}`}>{email}</a><br />
					Web <a class="c-cyan" href="/contact">taf.sh/contact</a>
				</p>
				<p class="c-green vt-body vt-flash">
					NOW ACCEPTING WORK FOR Q4 2026
				</p>
				<p class="c-white vt-fine">
					Transmission ends when the work ships. Subtitles are always on: every
					decision is written down.
				</p>
			</section>

			<!-- FASTEXT -->
			<nav class="vt-fastext" aria-label="Fastext">
				<a href="#tt-200" class="ft ft-red">PRODUCTS</a>
				<a href="#tt-300" class="ft ft-green">SERVICES</a>
				<a href="#tt-400" class="ft ft-yellow">PROCESS</a>
				<a href="/contact" class="ft ft-cyan">CONTACT</a>
			</nav>
		</div>

		<div class="vt-scan" aria-hidden="true"></div>
		<div class="vt-glow" aria-hidden="true"></div>
	</div>
</div>

<script is:inline>
	(function () {
		var el = document.getElementById("tt-clock");
		if (!el) return;
		function tick() {
			var d = new Date();
			var p = function (n) {
				return String(n).padStart(2, "0");
			};
			el.textContent = p(d.getHours()) + ":" + p(d.getMinutes()) + "/" + p(d.getSeconds());
		}
		tick();
		setInterval(tick, 1000);
	})();
</script>

<style>
	.vt {
		--black: #000;
		--red: #f00;
		--green: #0f0;
		--yellow: #ff0;
		--blue: #00f;
		--magenta: #f0f;
		--cyan: #0ff;
		--white: #fff;
		background: #101010;
		min-height: 100vh;
		padding: 1.5rem 0.75rem 3rem;
		font-family: "VT323", "IBM Plex Mono", monospace;
	}
	.vt-screen {
		position: relative;
		max-width: 52rem;
		margin: 0 auto;
		background: var(--black);
		border-radius: 14px;
		overflow: hidden;
		box-shadow:
			0 0 0 10px #1b1b1b,
			0 0 0 12px #2c2c2c,
			0 24px 70px rgba(0, 0, 0, 0.8);
	}
	.vt-page {
		position: relative;
		z-index: 2;
		padding: 1rem 1.1rem 0;
		font-size: 1.35rem;
		line-height: 1.15;
		letter-spacing: 0.02em;
	}
	.vt a {
		text-decoration: none;
	}
	.vt a:hover {
		background: var(--white);
		color: var(--black) !important;
	}

	/* palette */
	.c-white { color: var(--white); }
	.c-yellow { color: var(--yellow); }
	.c-cyan { color: var(--cyan); }
	.c-green { color: var(--green); }
	.c-magenta { color: var(--magenta); }
	.c-red { color: var(--red); }

	/* status row */
	.vt-status {
		display: flex;
		gap: 1.25rem;
		flex-wrap: wrap;
		padding-bottom: 0.5rem;
	}

	/* masthead */
	.vt-masthead {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		background: #000;
		padding: 0.5rem 0 0.75rem;
	}
	.vt-mosaic {
		display: grid;
		grid-template-columns: repeat(8, 12px);
		grid-auto-rows: 14px;
		flex: 0 0 auto;
	}
	.vt-px {
		display: block;
	}
	.vt-px.on-white {
		background: var(--white);
	}
	.vt-px.on-grey {
		background: var(--cyan);
	}
	.vt-dbl {
		margin: 0;
		font-size: 3.4rem;
		line-height: 0.85;
		letter-spacing: 0.02em;
	}
	.vt-dbl-sub {
		margin: 0.1rem 0 0;
		font-size: 1.7rem;
		line-height: 1;
	}
	.vt-tag {
		margin: 0.25rem 0 0;
		font-size: 1.1rem;
	}

	/* separator built from block characters */
	.vt-sep {
		height: 10px;
		margin: 0.5rem 0 0.75rem;
		background: repeating-linear-gradient(
			90deg,
			var(--cyan) 0 12px,
			var(--magenta) 12px 24px,
			var(--yellow) 24px 36px,
			var(--green) 36px 48px
		);
		opacity: 0.85;
	}

	/* index */
	.vt-idx-head {
		margin: 0 0 0.35rem;
		font-size: 1.2rem;
		letter-spacing: 0.3em;
	}
	.vt-idx-row {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		padding: 0.05rem 0.25rem;
	}
	.vt-idx-n {
		flex: 0 0 auto;
	}
	.vt-dots {
		flex: 1 1 auto;
		border-bottom: 2px dotted #444;
		transform: translateY(-0.3rem);
	}
	.vt-idx-l {
		flex: 0 0 auto;
	}

	/* sections */
	.vt-sec {
		margin: 1.5rem 0 0;
		scroll-margin-top: 1rem;
	}
	.vt-hd {
		display: inline-block;
		margin: 0 0 0.5rem;
		padding: 0 0.5rem;
		font-size: 1.5rem;
		color: var(--black);
	}
	.on-cyan { background: var(--cyan); }
	.on-green { background: var(--green); }
	.on-yellow { background: var(--yellow); }
	.on-magenta { background: var(--magenta); }
	.on-white { background: var(--white); }

	.vt-body {
		margin: 0 0 0.6rem;
		max-width: 46ch;
	}
	.vt-note {
		margin: 0.5rem 0 0;
		max-width: 46ch;
	}
	.vt-fine {
		margin: 0.6rem 0 0;
		font-size: 1.15rem;
		color: #8a8a8a;
		max-width: 46ch;
	}

	/* products */
	.vt-prod {
		display: block;
		padding: 0.3rem 0.25rem;
		border-left: 6px solid #222;
	}
	.vt-prod:hover {
		border-left-color: var(--yellow);
		background: #111;
	}
	.vt-prod:hover * {
		color: inherit;
	}
	.vt-prod-top {
		display: flex;
		gap: 0.75rem;
		align-items: baseline;
		margin: 0;
		flex-wrap: wrap;
	}
	.vt-prod-name {
		flex: 1 1 auto;
	}
	.vt-prod-desc {
		margin: 0 0 0.35rem;
		max-width: 46ch;
	}

	/* services grid */
	.vt-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: 0.75rem 1.5rem;
	}
	.vt-cell {
		border-top: 3px solid #333;
		padding-top: 0.35rem;
	}
	.vt-cell-n,
	.vt-cell-t,
	.vt-cell-b {
		margin: 0;
	}
	.vt-cell-b {
		max-width: 34ch;
	}

	/* process */
	.vt-step {
		display: grid;
		grid-template-columns: 3.5rem 12rem 1fr;
		gap: 0.5rem;
		margin: 0 0 0.35rem;
		align-items: baseline;
	}

	/* stats */
	.vt-stats {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		text-align: center;
	}
	.vt-big {
		margin: 0;
		font-size: 4rem;
		line-height: 0.9;
	}
	.vt-stat-l {
		margin: 0.2rem 0 0;
		font-size: 1.1rem;
	}

	.vt-flash {
		animation: vt-blink 1.4s steps(1) infinite;
	}
	@keyframes vt-blink {
		0%,
		60% {
			opacity: 1;
		}
		61%,
		100% {
			opacity: 0.25;
		}
	}

	/* fastext */
	.vt-fastext {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 2px;
		margin: 2rem -1.1rem 0;
	}
	.ft {
		padding: 0.5rem 0.25rem;
		text-align: center;
		color: var(--black);
		font-size: 1.15rem;
		letter-spacing: 0.08em;
	}
	.ft-red { background: var(--red); }
	.ft-green { background: var(--green); }
	.ft-yellow { background: var(--yellow); }
	.ft-cyan { background: var(--cyan); }
	.ft:hover {
		outline: 3px solid var(--white);
		outline-offset: -3px;
	}

	/* CRT */
	.vt-scan {
		position: absolute;
		inset: 0;
		z-index: 3;
		pointer-events: none;
		background: repeating-linear-gradient(
			180deg,
			rgba(0, 0, 0, 0.28) 0 1px,
			transparent 1px 3px
		);
	}
	.vt-glow {
		position: absolute;
		inset: 0;
		z-index: 4;
		pointer-events: none;
		background: radial-gradient(
			ellipse at 50% 45%,
			rgba(255, 255, 255, 0.05),
			rgba(0, 0, 0, 0.55) 78%
		);
	}

	@media (max-width: 620px) {
		.vt-page {
			font-size: 1.15rem;
			padding: 0.75rem 0.75rem 0;
		}
		.vt-masthead {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.75rem;
		}
		.vt-dbl {
			font-size: 2.6rem;
		}
		.vt-step {
			grid-template-columns: 3rem 1fr;
		}
		.vt-step span:last-child {
			grid-column: 2;
		}
		.vt-stats {
			grid-template-columns: 1fr;
		}
		.vt-fastext {
			grid-template-columns: repeat(2, 1fr);
			margin: 1.5rem -0.75rem 0;
		}
	}
</style>
