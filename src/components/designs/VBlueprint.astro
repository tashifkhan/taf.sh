---
/**
 * Blueprint / schematic — navy field, cyan construction lines, engineering drawing feel.
 */
import { products, services, stats } from "./data";
---

<div class="vbp">
	<div class="vbp-grid" aria-hidden="true"></div>

	<header class="vbp-nav">
		<div class="vbp-title-block">
			<span class="vbp-sheet">SHEET 01 / A</span>
			<a href="/" class="vbp-logo">TAF.SH</a>
		</div>
		<div class="vbp-meta">
			<span>SCALE 1:1</span>
			<span>REV 2026</span>
			<a href="/contact">REQ →</a>
		</div>
	</header>

	<section class="vbp-hero">
		<div class="vbp-callout">
			<span class="vbp-dim">NOTE A</span>
			<p>SOLE PROPRIETORSHIP · SOFTWARE STUDIO</p>
		</div>
		<h1>
			SYSTEM SPEC:<br />
			<span>INDEPENDENT</span><br />
			<span>ENGINEERING</span>
		</h1>
		<p class="vbp-abstract">
			PURPOSE: Design, build, and operate AI-native products (TalentSync, CliniQ)
			and deliver end-to-end consulting for select teams.
		</p>
		<div class="vbp-actions">
			<a href="/contact" class="vbp-btn">INITIATE CONTACT</a>
			<a href="/#products" class="vbp-btn ghost">VIEW ASSEMBLIES</a>
		</div>

		<svg class="vbp-diagram" viewBox="0 0 320 180" aria-hidden="true">
			<rect x="10" y="20" width="80" height="50" class="vbp-box"></rect>
			<text x="50" y="50" class="vbp-svg-t">INPUT</text>
			<line x1="90" y1="45" x2="130" y2="45" class="vbp-line"></line>
			<polygon points="130,40 140,45 130,50" class="vbp-arrow"></polygon>
			<rect x="140" y="15" width="100" height="60" class="vbp-box accent"></rect>
			<text x="190" y="50" class="vbp-svg-t">TAF.SH</text>
			<line x1="240" y1="45" x2="280" y2="45" class="vbp-line"></line>
			<polygon points="280,40 290,45 280,50" class="vbp-arrow"></polygon>
			<rect x="290" y="20" width="20" height="50" class="vbp-box"></rect>
			<line x1="190" y1="75" x2="190" y2="110" class="vbp-line"></line>
			<rect x="100" y="110" width="80" height="40" class="vbp-box"></rect>
			<text x="140" y="135" class="vbp-svg-t">TS</text>
			<rect x="200" y="110" width="80" height="40" class="vbp-box"></rect>
			<text x="240" y="135" class="vbp-svg-t">CQ</text>
			<line x1="190" y1="110" x2="140" y2="110" class="vbp-line"></line>
			<line x1="190" y1="110" x2="240" y2="110" class="vbp-line"></line>
			<circle cx="190" cy="45" r="3" class="vbp-dot"></circle>
		</svg>
	</section>

	<section class="vbp-stats">
		{
			stats.map((s, i) => (
				<div class="vbp-stat">
					<span class="vbp-ref">REF.{String.fromCharCode(65 + i)}</span>
					<span class="vbp-n">{s.value}</span>
					<span class="vbp-l">{s.label.toUpperCase()}</span>
				</div>
			))
		}
	</section>

	<section class="vbp-section" id="products">
		<div class="vbp-sec-head">
			<span class="vbp-dim">PARTS LIST</span>
			<h2>PRODUCT ASSEMBLIES</h2>
		</div>
		<table class="vbp-table">
			<thead>
				<tr>
					<th>P/N</th>
					<th>NAME</th>
					<th>STATUS</th>
					<th>DESCRIPTION</th>
				</tr>
			</thead>
			<tbody>
				{
					products.map((p) => (
						<tr>
							<td>{p.index}</td>
							<td>
								<a href={p.href}>{p.name}</a>
							</td>
							<td>{p.status.toUpperCase()}</td>
							<td>{p.desc}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</section>

	<section class="vbp-section">
		<div class="vbp-sec-head">
			<span class="vbp-dim">SCOPE OF WORK</span>
			<h2>ENGAGEMENT MODULES</h2>
		</div>
		<div class="vbp-modules">
			{
				services.map((s, i) => (
					<div class="vbp-mod">
						<span class="vbp-mod-n">M{i + 1}</span>
						<strong>{s.title.toUpperCase()}</strong>
						<p>{s.body}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="vbp-cta">
		<div class="vbp-cta-frame">
			<span class="vbp-corner tl"></span>
			<span class="vbp-corner tr"></span>
			<span class="vbp-corner bl"></span>
			<span class="vbp-corner br"></span>
			<p class="vbp-dim">APPROVAL BLOCK</p>
			<h2>REQUEST DRAWING REVIEW</h2>
			<p>Select engagements only. One engineer. Full stack ownership.</p>
			<a href="/contact" class="vbp-btn">SIGN OFF → CONTACT</a>
		</div>
	</section>

	<footer class="vbp-foot">
		<span>DWG NO. TAF-2026-HOME</span>
		<span>©2026 TAF.SH · DO NOT SCALE</span>
	</footer>
</div>

<style>
	.vbp {
		--navy: #0a1628;
		--navy-2: #0d1f38;
		--cyan: #5ec8ff;
		--cyan-dim: #2a6a8a;
		--ink: #c8e6f5;
		--muted: #6a90a8;
		position: relative;
		background: var(--navy);
		color: var(--ink);
		font-family: "IBM Plex Mono", ui-monospace, monospace;
		min-height: 100vh;
		overflow-x: hidden;
	}
	.vbp-grid {
		pointer-events: none;
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(94, 200, 255, 0.04) 1px, transparent 1px),
			linear-gradient(90deg, rgba(94, 200, 255, 0.04) 1px, transparent 1px);
		background-size: 24px 24px;
		mask-image: radial-gradient(ellipse at center, black 30%, transparent 80%);
	}
	.vbp a {
		color: var(--cyan);
		text-decoration: none;
	}
	.vbp a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.vbp-nav {
		position: relative;
		z-index: 1;
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		padding: 1.25rem 1.5rem;
		border-bottom: 1px solid var(--cyan-dim);
	}
	.vbp-sheet {
		display: block;
		font-size: 0.65rem;
		color: var(--muted);
		letter-spacing: 0.12em;
	}
	.vbp-logo {
		font-size: 1.35rem;
		font-weight: 500;
		letter-spacing: 0.15em;
		color: var(--cyan) !important;
		text-decoration: none !important;
	}
	.vbp-meta {
		display: flex;
		gap: 1.25rem;
		font-size: 0.7rem;
		color: var(--muted);
		letter-spacing: 0.08em;
	}
	.vbp-hero {
		position: relative;
		z-index: 1;
		padding: 3rem 1.5rem 2rem;
		max-width: 72rem;
		margin: 0 auto;
		display: grid;
		gap: 1.5rem;
	}
	@media (min-width: 900px) {
		.vbp-hero {
			grid-template-columns: 1.2fr 0.8fr;
			align-items: start;
		}
	}
	.vbp-callout {
		grid-column: 1 / -1;
		display: inline-flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 0.65rem 0.85rem;
		border: 1px solid var(--cyan-dim);
		width: fit-content;
		background: rgba(94, 200, 255, 0.04);
	}
	.vbp-callout p {
		margin: 0;
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		color: var(--cyan);
	}
	.vbp-dim {
		font-size: 0.65rem;
		letter-spacing: 0.14em;
		color: var(--muted);
	}
	.vbp-hero h1 {
		margin: 0;
		font-size: clamp(1.75rem, 4.5vw, 2.75rem);
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: 0.04em;
	}
	.vbp-hero h1 span {
		color: var(--cyan);
	}
	.vbp-abstract {
		margin: 0;
		max-width: 32rem;
		font-size: 0.85rem;
		line-height: 1.7;
		color: var(--muted);
	}
	.vbp-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.vbp-btn {
		display: inline-block;
		padding: 0.7rem 1.15rem;
		border: 1px solid var(--cyan);
		background: rgba(94, 200, 255, 0.12);
		color: var(--cyan) !important;
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		text-decoration: none !important;
		transition: background 0.15s;
	}
	.vbp-btn:hover {
		background: rgba(94, 200, 255, 0.22);
	}
	.vbp-btn.ghost {
		background: transparent;
		border-color: var(--cyan-dim);
		color: var(--muted) !important;
	}
	.vbp-diagram {
		width: 100%;
		max-width: 320px;
		justify-self: end;
		opacity: 0.9;
	}
	.vbp-box {
		fill: rgba(10, 22, 40, 0.6);
		stroke: var(--cyan-dim);
		stroke-width: 1;
	}
	.vbp-box.accent {
		stroke: var(--cyan);
		fill: rgba(94, 200, 255, 0.08);
	}
	.vbp-line {
		stroke: var(--cyan-dim);
		stroke-width: 1;
	}
	.vbp-arrow {
		fill: var(--cyan);
	}
	.vbp-dot {
		fill: var(--cyan);
	}
	.vbp-svg-t {
		fill: var(--cyan);
		font-size: 11px;
		text-anchor: middle;
		font-family: "IBM Plex Mono", monospace;
	}
	.vbp-stats {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		max-width: 72rem;
		margin: 0 auto;
		border: 1px solid var(--cyan-dim);
		border-left: none;
		border-right: none;
	}
	.vbp-stat {
		padding: 1.5rem;
		border-right: 1px solid var(--cyan-dim);
		text-align: center;
	}
	.vbp-stat:last-child {
		border-right: none;
	}
	.vbp-ref {
		display: block;
		font-size: 0.65rem;
		color: var(--muted);
		letter-spacing: 0.12em;
	}
	.vbp-n {
		display: block;
		margin-top: 0.4rem;
		font-size: 2.5rem;
		color: var(--cyan);
		letter-spacing: 0.05em;
	}
	.vbp-l {
		display: block;
		margin-top: 0.35rem;
		font-size: 0.65rem;
		color: var(--muted);
		letter-spacing: 0.08em;
	}
	.vbp-section {
		position: relative;
		z-index: 1;
		max-width: 72rem;
		margin: 0 auto;
		padding: 3rem 1.5rem;
	}
	.vbp-sec-head {
		margin-bottom: 1.5rem;
	}
	.vbp-sec-head h2 {
		margin: 0.35rem 0 0;
		font-size: 1.15rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		color: var(--cyan);
	}
	.vbp-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.75rem;
	}
	.vbp-table th {
		text-align: left;
		padding: 0.65rem 0.75rem;
		border: 1px solid var(--cyan-dim);
		color: var(--muted);
		letter-spacing: 0.1em;
		font-weight: 500;
		background: rgba(94, 200, 255, 0.05);
	}
	.vbp-table td {
		padding: 0.85rem 0.75rem;
		border: 1px solid var(--cyan-dim);
		vertical-align: top;
		line-height: 1.5;
		color: var(--ink);
	}
	.vbp-table td:first-child {
		color: var(--cyan);
		width: 3rem;
	}
	.vbp-modules {
		display: grid;
		gap: 1px;
		background: var(--cyan-dim);
		border: 1px solid var(--cyan-dim);
	}
	@media (min-width: 700px) {
		.vbp-modules {
			grid-template-columns: 1fr 1fr;
		}
	}
	.vbp-mod {
		background: var(--navy);
		padding: 1.25rem;
	}
	.vbp-mod-n {
		display: block;
		font-size: 0.7rem;
		color: var(--cyan);
		letter-spacing: 0.12em;
		margin-bottom: 0.5rem;
	}
	.vbp-mod strong {
		display: block;
		font-weight: 500;
		font-size: 0.85rem;
		letter-spacing: 0.06em;
	}
	.vbp-mod p {
		margin: 0.5rem 0 0;
		font-size: 0.75rem;
		line-height: 1.55;
		color: var(--muted);
	}
	.vbp-cta {
		position: relative;
		z-index: 1;
		padding: 2rem 1.5rem 4rem;
		max-width: 40rem;
		margin: 0 auto;
	}
	.vbp-cta-frame {
		position: relative;
		padding: 2.5rem 1.5rem;
		border: 1px solid var(--cyan);
		text-align: center;
		background: rgba(94, 200, 255, 0.03);
	}
	.vbp-corner {
		position: absolute;
		width: 12px;
		height: 12px;
		border: 2px solid var(--cyan);
	}
	.vbp-corner.tl {
		top: -1px;
		left: -1px;
		border-right: none;
		border-bottom: none;
	}
	.vbp-corner.tr {
		top: -1px;
		right: -1px;
		border-left: none;
		border-bottom: none;
	}
	.vbp-corner.bl {
		bottom: -1px;
		left: -1px;
		border-right: none;
		border-top: none;
	}
	.vbp-corner.br {
		bottom: -1px;
		right: -1px;
		border-left: none;
		border-top: none;
	}
	.vbp-cta-frame h2 {
		margin: 0.5rem 0 0;
		font-size: 1.25rem;
		font-weight: 500;
		letter-spacing: 0.1em;
	}
	.vbp-cta-frame > p:not(.vbp-dim) {
		margin: 0.75rem 0 0;
		font-size: 0.8rem;
		color: var(--muted);
		line-height: 1.55;
	}
	.vbp-cta-frame .vbp-btn {
		margin-top: 1.5rem;
	}
	.vbp-foot {
		position: relative;
		z-index: 1;
		display: flex;
		justify-content: space-between;
		padding: 1rem 1.5rem;
		border-top: 1px solid var(--cyan-dim);
		font-size: 0.65rem;
		letter-spacing: 0.1em;
		color: var(--muted);
	}
	@media (max-width: 700px) {
		.vbp-stats {
			grid-template-columns: 1fr;
		}
		.vbp-stat {
			border-right: none;
			border-bottom: 1px solid var(--cyan-dim);
		}
		.vbp-table {
			display: block;
			overflow-x: auto;
		}
		.vbp-meta span:not(:last-child) {
			display: none;
		}
	}
</style>
