---
const modes = [
	{ id: "system", label: "System theme" },
	{ id: "light", label: "Light theme" },
	{ id: "dark", label: "Dark theme" },
] as const;
---

<!--
	A pill with a disc that slides to the selected mode. The disc follows
	`aria-pressed` through :has(), so it needs no script of its own, and it only
	animates once the first `apply` has run (`data-ready`) so a stored override
	doesn't slide in on every page load.
-->
<div
	class="group/theme relative isolate flex h-10 shrink-0 items-center rounded-full border border-border-strong p-1"
	role="group"
	aria-label="Color theme"
	data-theme-toggle
>
	<span
		class="absolute top-1 left-1 -z-1 size-8 rounded-full border border-accent/40 bg-accent-soft group-has-[[data-theme-set=light][aria-pressed=true]]/theme:translate-x-full group-has-[[data-theme-set=dark][aria-pressed=true]]/theme:translate-x-[200%] group-data-ready/theme:transition-[translate] group-data-ready/theme:duration-500 group-data-ready/theme:ease-expo"
		aria-hidden="true"
	></span>
	{
		modes.map((mode) => (
			<button
				type="button"
				data-theme-set={mode.id}
				title={mode.label}
				aria-label={mode.label}
				aria-pressed="false"
				class="grid size-8 cursor-pointer place-items-center rounded-full text-muted transition-[color,scale] duration-300 hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:scale-90 aria-pressed:text-accent"
			>
				{mode.id === "system" && (
					<svg
						class="size-3.5"
						width="16"
						height="16"
						viewBox="0 0 16 16"
						fill="none"
						stroke="currentColor"
						stroke-width="1.4"
						aria-hidden="true"
					>
						<rect x="1.5" y="2.5" width="13" height="9" />
						<path d="M5.5 14h5M8 11.5V14" />
					</svg>
				)}
				{mode.id === "light" && (
					<svg
						class="size-3.5"
						width="16"
						height="16"
						viewBox="0 0 16 16"
						fill="none"
						stroke="currentColor"
						stroke-width="1.4"
						aria-hidden="true"
					>
						<circle cx="8" cy="8" r="3.1" />
						<path d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.1 3.1l1.1 1.1M11.8 11.8l1.1 1.1M12.9 3.1l-1.1 1.1M4.2 11.8l-1.1 1.1" />
					</svg>
				)}
				{mode.id === "dark" && (
					<svg
						class="size-3.5"
						width="16"
						height="16"
						viewBox="0 0 16 16"
						fill="none"
						stroke="currentColor"
						stroke-width="1.4"
						aria-hidden="true"
					>
						<path d="M13.4 9.6A5.8 5.8 0 0 1 6.4 2.6a5.8 5.8 0 1 0 7 7Z" />
					</svg>
				)}
			</button>
		))
	}
</div>

<script>
	const KEY = "taf-theme";
	const root = document.documentElement;
	const media = matchMedia("(prefers-color-scheme: light)");

	type Mode = "system" | "light" | "dark";

	const read = (): Mode => {
		const stored = localStorage.getItem(KEY);
		return stored === "light" || stored === "dark" ? stored : "system";
	};

	const apply = (mode: Mode) => {
		if (mode === "system") {
			delete root.dataset.theme;
			localStorage.removeItem(KEY);
		} else {
			root.dataset.theme = mode;
			localStorage.setItem(KEY, mode);
		}

		// ThemeScript pins `color-scheme` inline so an override is live before the
		// stylesheet loads; that inline value outranks global.css, so it has to be
		// kept in step here rather than left behind on the previous mode.
		root.style.colorScheme = mode === "system" ? "" : mode;

		const resolved = mode === "system" ? (media.matches ? "light" : "dark") : mode;
		document
			.querySelector("meta[data-theme-color]")
			?.setAttribute("content", resolved === "light" ? "#f4f2f0" : "#0e0d0d");

		document.querySelectorAll<HTMLButtonElement>("[data-theme-set]").forEach((button) => {
			button.setAttribute(
				"aria-pressed",
				String(button.dataset.themeSet === mode),
			);
		});
	};

	const reduced = matchMedia("(prefers-reduced-motion: reduce)");

	/**
	 * Cross-fade the palette swap with a same-document view transition. The
	 * `theme` type lets global.css swap the navigation animation for a plain
	 * fade; browsers without the API just repaint instantly.
	 */
	const supportsTypes = CSS.supports(
		"selector(:active-view-transition-type(theme))",
	);

	const select = (mode: Mode, origin: HTMLElement) => {
		if (mode === read()) return;
		if (!document.startViewTransition || reduced.matches) return apply(mode);
		// Without transition types the root would reuse the navigation slide,
		// which reads wrong for a palette swap — repaint instantly instead.
		if (!supportsTypes) return apply(mode);

		// The reveal grows from the pressed button out to the farthest corner.
		const box = origin.getBoundingClientRect();
		const x = box.left + box.width / 2;
		const y = box.top + box.height / 2;
		const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
		root.style.setProperty("--vt-x", `${x}px`);
		root.style.setProperty("--vt-y", `${y}px`);
		root.style.setProperty("--vt-r", `${r}px`);
		root.dataset.themeSwitch = "";

		const transition = document.startViewTransition({
			update: () => apply(mode),
			types: ["theme"],
		} as unknown as () => void);
		transition.finished.finally(() => delete root.dataset.themeSwitch);
	};

	document.querySelectorAll<HTMLButtonElement>("[data-theme-set]").forEach((button) => {
		button.addEventListener("click", () => select(button.dataset.themeSet as Mode, button));
	});

	media.addEventListener("change", () => {
		if (read() === "system") apply("system");
	});

	apply(read());
	requestAnimationFrame(() => {
		document.querySelectorAll<HTMLElement>("[data-theme-toggle]").forEach((toggle) => {
			toggle.dataset.ready = "";
		});
	});
</script>
