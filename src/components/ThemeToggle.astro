---
const modes = [
	{ id: "system", label: "System theme" },
	{ id: "light", label: "Light theme" },
	{ id: "dark", label: "Dark theme" },
] as const;
---

<div
	class="flex items-center border border-border"
	role="group"
	aria-label="Color theme"
	data-theme-toggle
>
	{
		modes.map((mode) => (
			<button
				type="button"
				data-theme-set={mode.id}
				title={mode.label}
				aria-label={mode.label}
				aria-pressed="false"
				class="px-2 py-1.5 text-muted transition-colors hover:text-foreground aria-pressed:bg-accent-soft aria-pressed:text-accent"
			>
				{mode.id === "system" && (
					<svg
						class="size-3.5"
						viewBox="0 0 16 16"
						fill="none"
						stroke="currentColor"
						stroke-width="1.4"
						aria-hidden="true"
					>
						<rect x="1.5" y="2.5" width="13" height="9" />
						<path d="M5.5 14h5M8 11.5V14" />
					</svg>
				)}
				{mode.id === "light" && (
					<svg
						class="size-3.5"
						viewBox="0 0 16 16"
						fill="none"
						stroke="currentColor"
						stroke-width="1.4"
						aria-hidden="true"
					>
						<circle cx="8" cy="8" r="3.1" />
						<path d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.1 3.1l1.1 1.1M11.8 11.8l1.1 1.1M12.9 3.1l-1.1 1.1M4.2 11.8l-1.1 1.1" />
					</svg>
				)}
				{mode.id === "dark" && (
					<svg
						class="size-3.5"
						viewBox="0 0 16 16"
						fill="none"
						stroke="currentColor"
						stroke-width="1.4"
						aria-hidden="true"
					>
						<path d="M13.4 9.6A5.8 5.8 0 0 1 6.4 2.6a5.8 5.8 0 1 0 7 7Z" />
					</svg>
				)}
			</button>
		))
	}
</div>

<script>
	const KEY = "taf-theme";
	const root = document.documentElement;
	const media = matchMedia("(prefers-color-scheme: light)");

	type Mode = "system" | "light" | "dark";

	const read = (): Mode => {
		const stored = localStorage.getItem(KEY);
		return stored === "light" || stored === "dark" ? stored : "system";
	};

	const apply = (mode: Mode) => {
		if (mode === "system") {
			delete root.dataset.theme;
			localStorage.removeItem(KEY);
		} else {
			root.dataset.theme = mode;
			localStorage.setItem(KEY, mode);
		}

		const resolved = mode === "system" ? (media.matches ? "light" : "dark") : mode;
		document
			.querySelector("meta[data-theme-color]")
			?.setAttribute("content", resolved === "light" ? "#f4f2f0" : "#0e0d0d");

		document.querySelectorAll<HTMLButtonElement>("[data-theme-set]").forEach((button) => {
			button.setAttribute(
				"aria-pressed",
				String(button.dataset.themeSet === mode),
			);
		});
	};

	document.querySelectorAll<HTMLButtonElement>("[data-theme-set]").forEach((button) => {
		button.addEventListener("click", () => apply(button.dataset.themeSet as Mode));
	});

	media.addEventListener("change", () => {
		if (read() === "system") apply("system");
	});

	apply(read());
</script>
